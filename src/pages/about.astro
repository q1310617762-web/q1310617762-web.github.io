---
import BaseLayout from '@layouts/BaseLayout.astro';
import { site, contacts } from '@data/site';
import WeChat from '@components/ui/WeChat.astro';
---
<BaseLayout title="关于我" description="东芽果DYG 的个人介绍：喜欢的游戏、常听的音乐与联系方式。" activeNav="/about">
  <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6">
    <header class="mb-10 text-center">
      <img src={site.avatar} alt={site.author} class="mx-auto mb-4 h-28 w-28 rounded-full shadow-(--shadow-card) ring-4 ring-(--color-primary)/40" />
      <h1 class="text-3xl font-extrabold text-(--color-text) dark:text-(--color-dark-text)">关于我</h1>
      <p class="mt-3 text-(--color-muted) dark:text-(--color-dark-muted)">喜欢游戏、音乐，也在 B 站做内容</p>
    </header>

    <div class="prose mx-auto text-(--color-text) dark:text-(--color-dark-text)">
      <p>
        你好，我是 <strong>{site.author}</strong>。喜欢玩游戏、听游戏原声，也在 B 站分享内容。
        这个博客是我的自留地，用来记录喜欢的游戏、常听的音乐，以及一些日常的想法。
      </p>

      <h2>我做什么</h2>
      <ul>
        <li>玩各种游戏：开放世界、单机、日麻、FPS 都玩</li>
        <li>收藏游戏 BGM：以原神、崩坏：星穹铁道为主</li>
        <li>在 <a href="https://space.bilibili.com/14184207" target="_blank" rel="noopener noreferrer">B 站</a> 做内容</li>
        <li>在这里写点东西，把想法留下来</li>
      </ul>

      <h2>我喜欢的游戏</h2>
      <p>
        原神、崩坏：星穹铁道、绝区零、塞尔达传说、星露谷物语、杀戮尖塔2、雀魂麻将、刺客信条、使命召唤、三角洲行动。
      </p>

      <h2>我也在听</h2>
      <p>
        游戏原声带。原神我按地区收藏（蒙德、璃月、稻妻、须弥、枫丹、纳塔…），
        另有星穹铁道的配乐，以及一套按场景自选的音乐（酒馆 / 战斗 / 城镇 / 夜晚探索…）。
      </p>

      <h2>联系我</h2>
      <p>欢迎通过以下方式联系我：</p>
    </div>

    <div class="mx-auto mt-6 grid max-w-xl grid-cols-1 gap-4 sm:grid-cols-2">
      {
        contacts.map((c) => (
          <a
            href={c.href}
            target={c.href.startsWith('http') ? '_blank' : undefined}
            rel="noopener noreferrer"
            class="group flex items-center justify-between rounded-(--radius-card) border border-(--color-border) bg-(--color-surface) px-5 py-4 transition-all duration-300 hover:-translate-y-1 hover:border-(--color-primary)/45 hover:shadow-(--shadow-card-hover) dark:border-(--color-dark-border) dark:bg-(--color-dark-surface)"
          >
            <span class="text-sm font-medium text-(--color-muted) dark:text-(--color-dark-muted)">{c.label}</span>
            <span class="truncate font-medium text-(--color-text) transition-colors group-hover:text-(--color-primary) dark:text-(--color-dark-text)">{c.value}</span>
          </a>
        ))
      }
    </div>

    <div class="mx-auto mt-5 max-w-xl">
      <WeChat />
    </div>
  </div>
</BaseLayout>
