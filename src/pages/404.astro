---
import BaseLayout from '@layouts/BaseLayout.astro';
---
<BaseLayout title="页面未找到" description="你访问的页面不存在。">
  <div class="mx-auto flex max-w-3xl flex-col items-center px-4 py-24 text-center sm:px-6">
    <p class="text-7xl font-extrabold text-(--color-primary)">404</p>
    <h1 class="mt-4 text-2xl font-bold text-(--color-text) dark:text-(--color-dark-text)">页面走丢了</h1>
    <p class="mt-2 text-(--color-muted) dark:text-(--color-dark-muted)">你访问的页面不存在或已被移动。</p>
    <a href="/" class="mt-8 inline-flex items-center justify-center rounded-(--radius-btn) bg-(--color-primary) px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-(--color-primary-strong)">
      返回首页
    </a>
  </div>
</BaseLayout>
