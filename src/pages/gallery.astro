---
import BaseLayout from '@layouts/BaseLayout.astro';
import GalleryGrid from '@components/blog/GalleryGrid.astro';
import { albums } from '@data/site';

const total = albums.reduce((s, a) => s + a.items.length, 0);
---
<BaseLayout title="相册" description="我的游戏截图记录：原神、崩坏：星穹铁道与绝区零。" activeNav="/gallery">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <header class="mb-10">
      <h1 class="text-3xl font-extrabold text-(--color-text) dark:text-(--color-dark-text)">相册</h1>
      <p class="mt-2 text-(--color-muted) dark:text-(--color-dark-muted)">
        {albums.length} 个相册 · 共 {total} 张截图 · 点击可放大查看
      </p>
    </header>

    <GalleryGrid />

    <p class="mt-8 text-center text-xs text-(--color-muted) dark:text-(--color-dark-muted)">
      提示：点击图片放大，← → 切换，Esc 关闭
    </p>
  </div>
</BaseLayout>
