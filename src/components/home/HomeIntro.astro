---
// 首页开屏：吃豆人沿折线路线行进（motion-lab 动效 + ui 令牌）
//
// 修正了上一版的两个致命问题：
//   1) conic-gradient 的 0deg 是「12 点方向」，上一版按「0deg=右」写，导致嘴一直朝上；
//      现在用 --pac-dir 表达朝向（0=右,90=下,180=左,270=上），嘴永远跟随行进方向。
//      眼睛不跟随旋转（否则朝左时眼睛会倒立），而是按行进方向换位。
//   2) 上一版在 prefers-reduced-motion 下把动画整个关掉，用户系统若关闭了动画效果，
//      就只能看到一只静止的吃豆人。现在无论何种偏好都会播放完整动画，
//      仅去掉漩涡旋转等非必要特效；随时可按 ESC / 点「跳过」结束。
//
// 路线：右下出发 → 向左 → 向上 → 向左咬住侧栏头像，之后漩涡把黑幕吸入头像结束。
// 豆子按「弧长」等分摆放，吃豆人匀速行进，命中时刻 = 弧长占比，因此豆子必然在
// 被吃到的瞬间消失（不靠估算、不靠定时器猜）。
import { site } from '@data/site';

const rawAvatar = site.avatar || '/avatar.jpg';
const base = import.meta.env.BASE_URL || '/';
const avatarSrc = base.replace(/\/$/, '') + (rawAvatar.startsWith('/') ? rawAvatar : `/${rawAvatar}`);

const DOT_COUNT = 9;
const statusText = 'INSERT COIN TO ENTER';

// 星辰粒子：两层反向旋转，各自绕头像点螺旋收缩。
// 用确定性公式生成（不用随机），保证每次构建结果一致。
// a=起始角度(黄金角分布) r=初始半径(vmin，随视口缩放) d=闪烁延迟 s=粒径 o=基础亮度
const makeStars = (count, seed, rMin, rMax) =>
  Array.from({ length: count }, (_, i) => ({
    a: Math.round((i * 137.508 + seed * 41) % 360),
    r: Math.round(rMin + ((i * 37 + seed * 13) % Math.max(1, rMax - rMin))),
    d: ((i * 53 + seed * 17) % 8) * 55,
    s: 2 + ((i + seed * 5) % 3),
    o: +(0.45 + ((i * 29 + seed * 11) % 5) * 0.12).toFixed(2),
  }));
const starsA = makeStars(28, 0, 19, 49);
const starsB = makeStars(20, 3, 9, 27);
---

<div class="intro" data-intro aria-label="开屏动画：吃豆人进入博客">
  <!-- 底色 + 黑洞：整个开屏的黑色背景由它承担，层级最低。
       被漩涡吸入的所有层都放在它内部，因此会随它的 clip-path 一起
       被收进头像边框里（由头像边缘吸收）。 -->
  <div class="intro-veil" data-intro-veil aria-hidden="true">
    <span class="intro-bh-disk" aria-hidden="true"></span>
    <!-- 星辰：两层反向旋转，被吸入头像边框 -->
    <span class="intro-stars intro-stars-a" aria-hidden="true">
      {starsA.map((s) => (
        <i style={`--a:${s.a}deg;--r:${s.r}vmin;--d:${s.d}ms;--s:${s.s}px;--o:${s.o}`} />
      ))}
    </span>
    <span class="intro-stars intro-stars-b" aria-hidden="true">
      {starsB.map((s) => (
        <i style={`--a:${s.a}deg;--r:${s.r}vmin;--d:${s.d}ms;--s:${s.s}px;--o:${s.o}`} />
      ))}
    </span>
  </div>

  <!-- 记分 HUD -->
  <div class="intro-hud" aria-hidden="true">
    <div class="intro-hud-cell">
      <span class="intro-hud-label">1UP</span>
      <span class="intro-hud-value" data-intro-score>0000</span>
    </div>
    <div class="intro-hud-cell">
      <span class="intro-hud-label">HIGH SCORE</span>
      <span class="intro-hud-value">19800</span>
    </div>
  </div>

  <!-- 路线层：豆子、吃豆人、终点头像都用视口坐标定位 -->
  <div class="intro-route" aria-hidden="true">
    <ol class="intro-dots" data-intro-dots>
      {Array.from({ length: DOT_COUNT }).map((_, i) => (
        <li class="intro-dot" data-intro-dot style={`--i:${i}`}>
          <span class="intro-dot-core" />
        </li>
      ))}
    </ol>

    <div class="intro-pac" data-intro-pac data-dir="right">
      <i class="intro-pac-eye" />
    </div>

    <div class="intro-target" data-intro-target>
      <img class="intro-target-img" src={avatarSrc} alt="" />
      <span class="intro-burst" />
    </div>
  </div>

  <!-- 字幕：mask-reveal 标题 + typewriter 状态行 -->
  <div class="intro-caption">
    <p class="intro-title"><span class="intro-title-inner">READY!</span></p>
    <p class="intro-status">
      <span data-intro-type data-text={statusText}></span><i class="intro-caret" />
    </p>
  </div>

  <button type="button" class="intro-skip" data-intro-skip aria-label="跳过开屏动画">
    跳过 <kbd class="intro-kbd">ESC</kbd>
  </button>
</div>

<script is:inline define:vars={{ avatarSrc }}>
  window.__AVATAR_SRC__ = avatarSrc;
</script>

<script>
  (function () {
    const root = document.querySelector('[data-intro]');
    if (!(root instanceof HTMLElement) || root.dataset.bound === '1') return;
    root.dataset.bound = '1';

    // ===== 时间轴（ms）=====
    const T = {
      enter: 380, // 入场（HUD/字幕/豆子浮现）
      travel: 3000, // 匀速走完整条路线
      impactHold: 320, // 撞上头像：吃豆人自毁 + 头像被撞得弹一下
      vortex: 900, // 黑幕漩涡吸入头像（此期间头像一直显示）
    };
    const RUN_END = T.enter + T.travel;

    // ---- 播放频率 ----
    const PLAY_EVERY_LOAD = true;
    const DAY_KEY = 'intro-last-day';
    const today = new Date().toDateString();
    const force = new URLSearchParams(location.search).get('intro') === '1';
    if (!force && !PLAY_EVERY_LOAD && localStorage.getItem(DAY_KEY) === today) {
      root.remove();
      return;
    }
    if (!PLAY_EVERY_LOAD) {
      try {
        localStorage.setItem(DAY_KEY, today);
      } catch {}
    }

    const pac = root.querySelector('[data-intro-pac]');
    const dotsWrap = root.querySelector('[data-intro-dots]');
    const dotEls = Array.from(root.querySelectorAll('[data-intro-dot]'));
    const target = root.querySelector('[data-intro-target]');
    const scoreEl = root.querySelector('[data-intro-score]');
    const statusEl = root.querySelector('[data-intro-type]');
    const skipBtn = root.querySelector('[data-intro-skip]');
    const veil = root.querySelector('[data-intro-veil]');

    const clamp01 = (p) => (p < 0 ? 0 : p > 1 ? 1 : p);
    let finished = false;
    let rafId = 0;
    const timers = [];
    const later = (fn, ms) => timers.push(window.setTimeout(fn, ms));

    function finish() {
      if (finished) return;
      finished = true;
      cancelAnimationFrame(rafId);
      timers.forEach((t) => window.clearTimeout(t));
      window.removeEventListener('keydown', onKey);
      window.removeEventListener('resize', onResize);
      root.classList.add('is-leaving');
      document.documentElement.classList.remove('intro-active');
      window.setTimeout(() => root.remove(), 520);
    }

    // 跳过入口必须在任何提前 return 之前注册，否则 finish() 会因 onKey 处于
    // 暂时性死区而抛错，导致开屏永远无法卸载（上一版就是这个坑）
    const onKey = (e) => {
      if (e.key === 'Escape') finish();
    };
    window.addEventListener('keydown', onKey);
    skipBtn?.addEventListener('click', finish, { once: true });

    document.documentElement.classList.add('intro-active');

    // ---- 音效：Web Audio 合成 ----
    let audioCtx = null;
    function ensureAudio() {
      if (!audioCtx) {
        try {
          audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        } catch {
          audioCtx = null;
        }
      }
      if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume().catch(() => {});
    }
    window.addEventListener('pointerdown', ensureAudio, { once: true });
    window.addEventListener('keydown', ensureAudio, { once: true });

    function blip(from, to, dur, vol, type) {
      if (!audioCtx || audioCtx.state !== 'running') return;
      const t0 = audioCtx.currentTime;
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = type || 'sine';
      osc.frequency.setValueAtTime(from, t0);
      osc.frequency.exponentialRampToValueAtTime(to, t0 + dur);
      gain.gain.setValueAtTime(vol, t0);
      gain.gain.exponentialRampToValueAtTime(0.001, t0 + dur);
      osc.connect(gain).connect(audioCtx.destination);
      osc.start(t0);
      osc.stop(t0 + dur + 0.02);
    }

    // 漩涡吸入：白噪声低通 + 低频嗡鸣
    function vortexSound() {
      if (!audioCtx || audioCtx.state !== 'running') return;
      const t0 = audioCtx.currentTime;
      const dur = 0.85;
      const len = Math.floor(audioCtx.sampleRate * dur);
      const buf = audioCtx.createBuffer(1, len, audioCtx.sampleRate);
      const d = buf.getChannelData(0);
      for (let i = 0; i < len; i++) d[i] = Math.random() * 2 - 1;
      const noise = audioCtx.createBufferSource();
      noise.buffer = buf;
      const lp = audioCtx.createBiquadFilter();
      lp.type = 'lowpass';
      lp.frequency.setValueAtTime(900, t0);
      lp.frequency.exponentialRampToValueAtTime(110, t0 + dur);
      lp.Q.value = 4;
      const ng = audioCtx.createGain();
      ng.gain.setValueAtTime(0, t0);
      ng.gain.linearRampToValueAtTime(0.16, t0 + 0.12);
      ng.gain.exponentialRampToValueAtTime(0.001, t0 + dur);
      noise.connect(lp).connect(ng).connect(audioCtx.destination);
      noise.start(t0);
      noise.stop(t0 + dur);
      const osc = audioCtx.createOscillator();
      const og = audioCtx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(120, t0);
      osc.frequency.exponentialRampToValueAtTime(42, t0 + dur);
      og.gain.setValueAtTime(0, t0);
      og.gain.linearRampToValueAtTime(0.07, t0 + 0.2);
      og.gain.exponentialRampToValueAtTime(0.001, t0 + dur);
      osc.connect(og).connect(audioCtx.destination);
      osc.start(t0);
      osc.stop(t0 + dur);
    }

    // ===== 路线（视口坐标折线）：右下 → 左 → 上 → 左咬住头像 =====
    function avatarCenter() {
      const side = document.querySelector('.app-aside img');
      if (side) {
        const r = side.getBoundingClientRect();
        if (r.width > 0) return { x: r.left + r.width / 2, y: r.top + r.height / 2, w: r.width };
      }
      return { x: 56, y: 56, w: 72 };
    }

    // 折线迷宫路线：左右上下交替，绕几道弯再咬住头像
    function buildRoute(t) {
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      const mobile = vw < 1024;
      if (mobile) {
        // 手机（窄）：绕 3 道弯 —— 左 → 上 → 右 → 上（进头像）
        const lane = vh * 0.78;
        const col = Math.max(vw * 0.16, 54);
        const row = vh * 0.38;
        return [
          { x: vw * 0.86, y: lane },
          { x: col, y: lane },
          { x: col, y: row },
          { x: t.x, y: row },
          { x: t.x, y: t.y },
        ];
      }
      // 桌面（宽）：三级阶梯，绕 6 道弯后再咬住头像
      // 左 → 上 → 左 → 上 → 左 → 上 → 左
      const lane = vh * 0.74;
      return [
        { x: vw * 0.9, y: lane },
        { x: vw * 0.64, y: lane },
        { x: vw * 0.64, y: vh * 0.55 },
        { x: vw * 0.44, y: vh * 0.55 },
        { x: vw * 0.44, y: vh * 0.36 },
        { x: vw * 0.26, y: vh * 0.36 },
        { x: vw * 0.26, y: t.y },
        { x: t.x, y: t.y },
      ];
    }

    const segLen = (a, b) => Math.hypot(b.x - a.x, b.y - a.y);

    function pointAt(pts, dist) {
      let acc = 0;
      for (let i = 0; i < pts.length - 1; i++) {
        const a = pts[i];
        const b = pts[i + 1];
        const len = segLen(a, b);
        if (acc + len >= dist || i === pts.length - 2) {
          const p = len > 0 ? clamp01((dist - acc) / len) : 0;
          return {
            x: a.x + (b.x - a.x) * p,
            y: a.y + (b.y - a.y) * p,
            // 屏幕角度：0=右, 90=下, 180=左, 270=上
            dir: (Math.atan2(b.y - a.y, b.x - a.x) * 180) / Math.PI,
          };
        }
        acc += len;
      }
      const last = pts[pts.length - 1];
      return { x: last.x, y: last.y, dir: 180 };
    }

    function dirName(deg) {
      const d = ((deg % 360) + 360) % 360;
      if (d < 45 || d >= 315) return 'right';
      if (d < 135) return 'down';
      if (d < 225) return 'left';
      return 'up';
    }

    // 屏幕角度（0=右, 90=下, 180=左, 270=上）；CSS 里 conic 的 0deg 在 12 点方向，
    // 所以真正写进 --pac-dir 的角度会由 CSS 再加 90deg 换算。
    const DIR_ANGLE = { right: '0deg', down: '90deg', left: '180deg', up: '270deg' };
    function setPacDir(name) {
      if (!pac) return;
      pac.dataset.dir = name; // 控制眼睛位置
      pac.style.setProperty('--pac-dir', DIR_ANGLE[name] || '0deg'); // 控制嘴的朝向
    }

    // ===== 布点：每段走廊中点放一颗，天然不会压在拐角上 =====
    let route = [];
    let total = 0;
    let dotHit = [];

    function layout() {
      const t = avatarCenter();
      route = buildRoute(t);
      // 累积弧长
      const cum = [0];
      for (let i = 0; i < route.length - 1; i++) cum.push(cum[i] + segLen(route[i], route[i + 1]));
      total = cum[cum.length - 1];

      if (target) {
        target.style.left = t.x + 'px';
        target.style.top = t.y + 'px';
      }
      // 让终点头像与侧栏真实头像「同尺寸」——否则边框对不上，
      // 黑幕收束到边框时会与真实头像错开一圈（真实头像 h-20 w-20 = 80px）。
      // --veil-end-r 就是黑幕最终收束的半径：收到头像边框而不是收成一个点。
      root.style.setProperty('--target-size', t.w + 'px');
      root.style.setProperty('--veil-end-r', t.w / 2 + 'px');
      if (veil) {
        root.style.setProperty('--vx', t.x + 'px');
        root.style.setProperty('--vy', t.y + 'px');
      }

      // 计分板避让：窄屏（<=1024px）时侧栏会变成顶部整块、头像挪到水平居中，
      // 而计分板默认也居中，两者会压在一起。这里按「实测头像位置」判断，
      // 而不是写死断点：头像靠近中线就让计分板左右贴边，给中间让位。
      const nearCenter = Math.abs(t.x - window.innerWidth / 2) < window.innerWidth * 0.2;
      root.classList.toggle('hud-edge', nearCenter);

      // 每段走廊中点一颗豆子；太短的段跳过，避免贴脸
      const mids = [];
      for (let i = 0; i < route.length - 1; i++) {
        const len = cum[i + 1] - cum[i];
        if (len < 72) continue;
        mids.push(cum[i] + len / 2);
      }
      const powerAt = Math.floor(mids.length / 2);

      dotHit = [];
      dotEls.forEach((el, i) => {
        if (i >= mids.length) {
          el.style.display = 'none';
          return;
        }
        el.style.display = '';
        const d = mids[i];
        const p = pointAt(route, d);
        el.style.left = p.x + 'px';
        el.style.top = p.y + 'px';
        el.classList.toggle('is-power', i === powerAt);
        dotHit.push({ el, d, eaten: false });
      });

      const p0 = pointAt(route, 0);
      setPacDir(dirName(p0.dir));
      // 立刻把吃豆人摆到起点：否则 is-armed 让它显形后、第一帧 rAF 之前，
      // 它会短暂停在路线层左上角 (0,0) 闪一下
      if (pac) {
        const half = pac.getBoundingClientRect().width / 2;
        pac.style.transform = `translate3d(${p0.x - half}px, ${p0.y - half}px, 0)`;
      }
    }

    // ===== 行进：匀速（弧长线性），朝向随分段切换 =====
    let score = 0;
    function onScore() {
      score = Math.min(score + 100, 1600);
      if (scoreEl) scoreEl.textContent = String(score).padStart(4, '0');
    }

    function startRun() {
      const size = pac ? pac.getBoundingClientRect().width : 56;
      const half = size / 2;
      // 判定用「嘴尖」而不是「身体中心」：豆子在嘴尖碰到它边缘的瞬间就消失。
      // 若用中心判定，张嘴时豆子会在嘴里亮着，直到被身体盖住才消失（显得不及时）。
      // 嘴尖碰到豆子边缘 ⇒ 两个中心相距 (吃豆人半径 + 豆子半径)
      const coreEl = dotEls[0] ? dotEls[0].querySelector('.intro-dot-core') : null;
      const dotR = coreEl ? parseFloat(getComputedStyle(coreEl).width) / 2 || 5 : 5;
      const eatLead = half + dotR;
      const t0 = performance.now();
      let lastDir = '';

      const frame = (now) => {
        const p = clamp01((now - t0) / T.travel);
        const d = p * total;
        const pos = pointAt(route, d);

        if (pac) {
          pac.style.transform = `translate3d(${pos.x - half}px, ${pos.y - half}px, 0)`;
          const dn = dirName(pos.dir);
          if (dn !== lastDir) {
            setPacDir(dn);
            lastDir = dn;
          }
        }

        // 吃豆：嘴尖一碰到就吃掉（同一 rAF 内判定，不存在延后）
        for (const h of dotHit) {
          if (!h.eaten && d + eatLead >= h.d) {
            h.eaten = true;
            h.el.classList.add('is-eaten');
            blip(620, 210, 0.075, 0.1, 'sine');
            onScore();
          }
        }

        if (p < 1) {
          rafId = requestAnimationFrame(frame);
        } else {
          reachTarget();
        }
      };
      rafId = requestAnimationFrame(frame);
    }

    function reachTarget() {
      // 撞上头像：吃豆人在这里被销毁（自毁动画），头像只是被撞得弹一下、保持可见
      root.classList.add('is-impact');
      if (pac) pac.classList.add('is-destroyed');
      blip(420, 80, 0.28, 0.13, 'square');
      later(() => {
        // 黑幕漩涡被吸进头像；这一整段里头像必须一直显示
        root.classList.add('is-absorbing');
        vortexSound();
      }, T.impactHold);
      later(finish, T.impactHold + T.vortex);
    }

    function onResize() {
      if (finished) return;
      layout();
    }

    // ---- 字幕：typewriter ----
    const fullText = statusEl ? statusEl.getAttribute('data-text') || '' : '';

    function boot() {
      layout();
      root.classList.add('is-armed');

      if (statusEl) {
        let i = 0;
        const timer = window.setInterval(() => {
          statusEl.textContent = fullText.slice(0, ++i);
          if (i >= fullText.length) window.clearInterval(timer);
        }, 62);
        timers.push(timer);
      }

      window.addEventListener('resize', onResize);
      later(startRun, T.enter);
    }

    // 无论 reduced-motion 与否都播放完整动画（用户明确要看到它）。
    // 该偏好只用来关掉漩涡旋转这类非必要特效，见 CSS 的 .is-reduced。
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      root.classList.add('is-reduced');
    }

    boot();
  })();
</script>
