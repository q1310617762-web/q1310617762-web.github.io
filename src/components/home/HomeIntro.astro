---
// 首页开屏：经典街机吃豆人（Canvas 极简版）
// 只有三要素：吃豆人、豆子、主页头像。
// 时间轴（总 4.2s）：吃豆人从左侧吃豆前进 → 吃下头像（爆裂）→ 头像吸入侧栏真实头像 → 全幕淡出。
// 音效：Web Audio 合成吃豆音（无资源文件）。
// 播放频率：PLAY_EVERY_LOAD=true 每次进首页都播（测试期）；改 false 后同一天只播一次。
// URL 带 ?intro=1 可强制播放（测试用）。
import { site } from '@data/site';
// 头像路径：BASE_URL + site.avatar（避免双斜杠）
const rawAvatar = site.avatar || '/avatar.jpg';
const base = import.meta.env.BASE_URL || '/';
const avatarSrc = base.replace(/\/$/, '') + (rawAvatar.startsWith('/') ? rawAvatar : `/${rawAvatar}`);
---

<div id="pac-intro" data-pac-intro aria-label="开屏动画：吃豆人进入博客">
  <canvas id="pac-canvas" aria-hidden="true"></canvas>
  <button type="button" id="pac-skip" class="pac-skip-btn" aria-label="跳过开屏动画">
    跳过<span class="pac-skip-key">ESC</span>
  </button>
</div>

<script is:inline define:vars={{ avatarSrc }}>
  window.__AVATAR_SRC__ = avatarSrc;
</script>

<script>
(function () {
  const root = document.getElementById('pac-intro');
  if (!root) return;

  // ---- 播放频率开关 ----
  const PLAY_EVERY_LOAD = true; // 测试期：每次进首页都播；上线改为 false（同一天只播一次）
  const DAY_KEY = 'pac-intro-last-day';
  const today = new Date().toDateString();
  const force =
    new URLSearchParams(location.search).get('intro') === '1' ||
    localStorage.getItem('pac-intro-force') === '1';
  if (!force && !PLAY_EVERY_LOAD && localStorage.getItem(DAY_KEY) === today) {
    root.remove();
    return;
  }
  if (!PLAY_EVERY_LOAD) localStorage.setItem(DAY_KEY, today);

  const canvas = document.getElementById('pac-canvas');
  const ctx = canvas.getContext('2d');
  const skipBtn = document.getElementById('pac-skip');
  if (!canvas || !ctx) return;

  // ---- 头像源：优先复用侧栏已加载好的 <img>（保证与侧栏 100% 一致），new Image() 兜底 ----
  const avatarImg = new Image();
  avatarImg.src = window.__AVATAR_SRC__;
  function getAvatarImg() {
    const side = document.querySelector('.app-aside img');
    if (side && side.complete && side.naturalWidth > 0) return side;
    return avatarImg;
  }

  // ---- 画布尺寸（跟随视口 + devicePixelRatio） ----
  let W = 0, H = 0, DPR = 1;
  function resize() {
    DPR = Math.min(window.devicePixelRatio || 1, 2);
    W = window.innerWidth;
    H = window.innerHeight;
    canvas.width = Math.round(W * DPR);
    canvas.height = Math.round(H * DPR);
    canvas.style.width = W + 'px';
    canvas.style.height = H + 'px';
  }
  resize();
  window.addEventListener('resize', resize);

  // ---- 侧栏头像位置（飞行终点，动态测量；移动端侧栏在顶部） ----
  function sidebarTarget() {
    const img = document.querySelector('.app-aside img');
    if (img) {
      const r = img.getBoundingClientRect();
      if (r.width > 0) return { x: r.left + r.width / 2, y: r.top + r.height / 2, w: r.width, h: r.height };
    }
    return { x: W / 2, y: 40, w: 72, h: 72 };
  }

  // ---- 几何：走廊 + 头像终点（极简：只有吃豆人、豆子、头像） ----
  function layout() {
    const isMobile = W < 640;
    const trackW = Math.min(W * 0.92, isMobile ? W - 24 : 720);
    const trackX = (W - trackW) / 2;
    const trackY = H / 2 - 60;
    const size = isMobile ? 56 : 72; // 吃豆人/头像直径
    const avatarX = trackX + trackW - size / 2 - 4;
    const avatarY = trackY;
    const start = { x: trackX + size / 2, y: trackY };
    const dots = [];
    const usableStart = trackX + size * 1.2;
    const usableEnd = avatarX - size * 1.1;
    for (let i = 0; i < 6; i++) {
      dots.push({
        x: usableStart + ((usableEnd - usableStart) / 5) * i,
        y: trackY,
        big: i === 3, // 第 4 颗是能量豆（稍大）
      });
    }
    return { trackW, trackX, trackY, size, avatarX, avatarY, start, dots };
  }

  // ---- 时间轴（ms） ----
  const T = {
    moveStart: 400,  // 吃豆人开始移动
    moveEnd: 2800,   // 到达头像
    eatAvatar: 2900, // 吃下头像（爆裂）
    absorb: 3300,    // 头像吸入侧栏
    end: 4200,       // 全幕淡出结束
  };
  const lerp = (a, b, p) => a + (b - a) * p;
  const easeOut = (p) => 1 - Math.pow(1 - p, 3);
  const clamp01 = (p) => Math.max(0, Math.min(1, p));

  // ---- 吃豆音效（Web Audio 合成，无资源文件） ----
  let audioCtx = null;
  function ensureAudio() {
    if (!audioCtx) {
      try {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      } catch (e) {
        audioCtx = null;
      }
    }
    if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume().catch(() => {});
  }
  // 首次交互（点击/按键）时解锁音频（浏览器自动播放策略）
  window.addEventListener('pointerdown', ensureAudio, { once: true });
  window.addEventListener('keydown', ensureAudio, { once: true });

  function playDotSound() {
    if (!audioCtx || audioCtx.state !== 'running') return;
    const t0 = audioCtx.currentTime;
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.type = 'sine';
    osc.frequency.setValueAtTime(600, t0);
    osc.frequency.exponentialRampToValueAtTime(200, t0 + 0.08);
    gain.gain.setValueAtTime(0.12, t0);
    gain.gain.exponentialRampToValueAtTime(0.001, t0 + 0.09);
    osc.connect(gain).connect(audioCtx.destination);
    osc.start(t0);
    osc.stop(t0 + 0.1);
  }
  function playBurstSound() {
    if (!audioCtx || audioCtx.state !== 'running') return;
    const t0 = audioCtx.currentTime;
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.type = 'square';
    osc.frequency.setValueAtTime(400, t0);
    osc.frequency.exponentialRampToValueAtTime(80, t0 + 0.3);
    gain.gain.setValueAtTime(0.15, t0);
    gain.gain.exponentialRampToValueAtTime(0.001, t0 + 0.32);
    osc.connect(gain).connect(audioCtx.destination);
    osc.start(t0);
    osc.stop(t0 + 0.35);
  }

  // 水漩涡音效：噪声（白噪声）低通滤波 + 低频嗡鸣，模拟"咕噜咕噜"吸水的声音
  function playSwirlSound() {
    if (!audioCtx || audioCtx.state !== 'running') return;
    const t0 = audioCtx.currentTime;
    const dur = 0.95;

    // 白噪声缓冲
    const bufLen = audioCtx.sampleRate * dur;
    const buf = audioCtx.createBuffer(1, bufLen, audioCtx.sampleRate);
    const data = buf.getChannelData(0);
    for (let i = 0; i < bufLen; i++) data[i] = Math.random() * 2 - 1;

    // 噪声 → 低通（频率从 800Hz 滑到 150Hz，像水被吸走）
    const noise = audioCtx.createBufferSource();
    noise.buffer = buf;
    const lp = audioCtx.createBiquadFilter();
    lp.type = 'lowpass';
    lp.frequency.setValueAtTime(800, t0);
    lp.frequency.exponentialRampToValueAtTime(120, t0 + dur);
    lp.Q.value = 4;

    const nGain = audioCtx.createGain();
    nGain.gain.setValueAtTime(0, t0);
    nGain.gain.linearRampToValueAtTime(0.18, t0 + 0.15);
    nGain.gain.exponentialRampToValueAtTime(0.001, t0 + dur);

    noise.connect(lp).connect(nGain).connect(audioCtx.destination);
    noise.start(t0);
    noise.stop(t0 + dur);

    // 低频嗡鸣（漩涡中心"嗡"声）
    const osc = audioCtx.createOscillator();
    const oGain = audioCtx.createGain();
    osc.type = 'sine';
    osc.frequency.setValueAtTime(110, t0);
    osc.frequency.exponentialRampToValueAtTime(45, t0 + dur);
    oGain.gain.setValueAtTime(0, t0);
    oGain.gain.linearRampToValueAtTime(0.08, t0 + 0.2);
    oGain.gain.exponentialRampToValueAtTime(0.001, t0 + dur);
    osc.connect(oGain).connect(audioCtx.destination);
    osc.start(t0);
    osc.stop(t0 + dur);
  }
  let lastDotIdx = -1;
  let burstPlayed = false;
  let swirlPlayed = false;

  function drawDots(t, L, pacmanX) {
    ctx.save();
    for (const d of L.dots) {
      if (pacmanX >= d.x - L.size * 0.2) continue; // 已被吃掉
      // 靠近吃豆人时轻微放大 + 呼吸，吃的时候更"活"
      const dist = d.x - pacmanX;
      const near = clamp01(1 - dist / (L.size * 3));
      const pulse = 0.8 + 0.2 * Math.sin(t / 260 + d.x) + near * 0.25;
      const r = (d.big ? 9 : 6) * pulse;
      ctx.fillStyle = d.big ? '#ffb897' : '#ffcc66';
      ctx.shadowColor = ctx.fillStyle;
      ctx.shadowBlur = 10 + near * 6;
      ctx.beginPath();
      ctx.arc(d.x, d.y, r, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.restore();
  }

  function drawPacMan(t, L, pacmanX, isMoving) {
    const r = L.size / 2;
    // 嘴部开合：前进时张合更快（吃豆感），静止时慢（待机感）
    const chomp = 0.5 + 0.5 * Math.sin(t / (isMoving ? 90 : 180));
    const mouth = 0.1 + chomp * 0.38;
    ctx.save();
    ctx.translate(pacmanX, L.trackY);
    ctx.fillStyle = '#ffd600';
    ctx.beginPath();
    ctx.arc(0, 0, r, mouth, Math.PI * 2 - mouth);
    ctx.lineTo(0, 0);
    ctx.closePath();
    ctx.fill();
    ctx.fillStyle = '#000';
    ctx.beginPath();
    ctx.arc(-r * 0.08, -r * 0.42, Math.max(3, r * 0.14), 0, Math.PI * 2);
    ctx.fill();
    ctx.restore();
  }

  function drawAvatarAt(x, y, d, alpha) {
    const img = getAvatarImg();
    if (!img.complete || !img.naturalWidth) {
      // 未加载完成：淡白占位圆
      ctx.save();
      ctx.globalAlpha = alpha * 0.35;
      ctx.fillStyle = '#ffffff';
      ctx.beginPath();
      ctx.arc(x, y, d / 2, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
      return;
    }
    // 纯圆形裁切贴图，无红圈无边框无光晕
    ctx.save();
    ctx.globalAlpha = alpha;
    ctx.beginPath();
    ctx.arc(x, y, d / 2, 0, Math.PI * 2);
    ctx.clip();
    ctx.drawImage(img, x - d / 2, y - d / 2, d, d);
    ctx.restore();
  }

  function drawBurst(t, L) {
    const p = clamp01((t - T.eatAvatar) / 400);
    if (p >= 1 || t < T.eatAvatar) return;
    ctx.save();
    const g = ctx.createRadialGradient(L.avatarX, L.avatarY, 0, L.avatarX, L.avatarY, 120 * p + 20);
    g.addColorStop(0, `rgba(255,255,255,${0.95 * (1 - p)})`);
    g.addColorStop(0.4, `rgba(255,214,0,${0.8 * (1 - p)})`);
    g.addColorStop(0.8, `rgba(255,59,48,${0.5 * (1 - p)})`);
    g.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.fillStyle = g;
    ctx.beginPath();
    ctx.arc(L.avatarX, L.avatarY, 120 * p + 20, 0, Math.PI * 2);
    ctx.fill();
    ctx.restore();
  }

  // 黑幕：水漩涡特效（螺旋臂旋入 + 涟漪环），向侧栏头像点吸入
  function drawBlackVeil(t, target) {
    const p = clamp01((t - T.absorb) / (T.end - T.absorb));
    const q = easeOut(p);
    const cx = target.x;
    const cy = target.y;
    const fullR = Math.hypot(W, H) * 1.1;
    // 1) 整幕黑
    ctx.save();
    ctx.fillStyle = '#000';
    ctx.fillRect(0, 0, W, H);

    // 2) 漩涡臂：螺旋线向心旋入（平滑，destination-out 擦黑幕露出主页）
    const armCount = 4;
    const twist = 2.6 * Math.PI; // 旋转总量
    const rot = p * twist * 0.5;
    // 揭开比例：前 35% 基本全黑，后 65% 才逐渐揭开（让漩涡有"蓄水"过程）
    const reveal = clamp01((p - 0.35) / 0.65);
    const holeQ = easeOut(reveal);
    const maxHole = fullR * 0.4;
    ctx.globalCompositeOperation = 'destination-out';
    ctx.lineCap = 'round';
    for (let a = 0; a < armCount; a++) {
      const baseAngle = (a / armCount) * Math.PI * 2 + rot;
      const steps = 48;
      ctx.beginPath();
      for (let s = 0; s <= steps; s++) {
        const sp = s / steps;
        // 半径从外缘向中心：外圈随 reveal 收缩，内圈保持
        const radius = lerp(fullR * (1 - holeQ * 0.75), maxHole * (1 - sp), sp);
        const angle = baseAngle + sp * twist * (0.5 + 0.5 * p);
        const px = cx + Math.cos(angle) * radius;
        const py = cy + Math.sin(angle) * radius;
        if (s === 0) ctx.moveTo(px, py);
        else ctx.lineTo(px, py);
      }
      ctx.lineWidth = 26 * (1 - p * 0.4) + 6;
      ctx.globalAlpha = 0.85;
      ctx.strokeStyle = 'rgba(0,0,0,1)';
      ctx.stroke();
    }
    ctx.globalAlpha = 1;

    // 3) 中心洞（漩涡汇合处，揭开主页）
    const holeR = lerp(0, maxHole, holeQ);
    if (holeR > 1) {
      const gg = ctx.createRadialGradient(cx, cy, 0, cx, cy, holeR);
      gg.addColorStop(0, 'rgba(0,0,0,1)');
      gg.addColorStop(0.85, 'rgba(0,0,0,0.9)');
      gg.addColorStop(1, 'rgba(0,0,0,0)');
      ctx.fillStyle = gg;
      ctx.beginPath();
      ctx.arc(cx, cy, holeR, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.restore();

    // 4) 水波纹涟漪（在黑幕之上，淡蓝色，向心收缩）
    ctx.save();
    const rippleCount = 3;
    for (let k = 0; k < rippleCount; k++) {
      const rp = clamp01((p - 0.1 - k * 0.22) / 0.55);
      if (rp <= 0 || rp >= 1) continue;
      const rr = lerp(fullR * 0.4, 0, easeOut(rp));
      ctx.strokeStyle = `rgba(140, 210, 255, ${0.28 * (1 - rp)})`;
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.arc(cx, cy, rr, 0, Math.PI * 2);
      ctx.stroke();
    }
    ctx.restore();
  }

  // 飞行头像：从走廊终点沿弧线飞入侧栏真实头像（缓动更平滑）
  function drawFlyingAvatar(t, L, target) {
    const p = clamp01((t - T.absorb) / 680);
    if (p >= 1) return;
    // 先快后慢的平滑缓动（easeInOutCubic 风格）
    const e = p < 0.5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2;
    const mx = lerp(L.avatarX, target.x, 0.5);
    const my = Math.min(L.avatarY, target.y) - L.size;
    const x = (1 - e) * (1 - e) * L.avatarX + 2 * (1 - e) * e * mx + e * e * target.x;
    const y = (1 - e) * (1 - e) * L.avatarY + 2 * (1 - e) * e * my + e * e * target.y;
    const d = lerp(L.size, Math.max(target.w, target.h) || L.size * 0.6, e);
    drawAvatarAt(x, y, d, 1 - p * 0.15);
  }

  // ---- 主循环 ----
  let rafId = 0, t0 = 0, finished = false, guardTimer = 0, onKey = null;

  function finish() {
    if (finished) return;
    finished = true;
    cancelAnimationFrame(rafId);
    window.clearTimeout(guardTimer);
    if (onKey) window.removeEventListener('keydown', onKey);
    root.remove();
    window.setTimeout(() => document.documentElement.classList.remove('pac-intro-active'), 900);
  }

  function frame(now) {
    const t = now - t0;
    const L = layout();
    const target = sidebarTarget();

    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    ctx.clearRect(0, 0, W, H);
    // 全黑背景（完全遮住主页，街机氛围）
    ctx.fillStyle = '#000';
    ctx.fillRect(0, 0, W, H);

    // 吃豆人移动：缓入缓出（细腻，不匀速生硬）
    const moveP = t < T.moveStart ? 0 : clamp01((t - T.moveStart) / (T.moveEnd - T.moveStart));
    const moveEased = moveP < 0.5 ? 2 * moveP * moveP : 1 - Math.pow(-2 * moveP + 2, 2) / 2; // easeInOutQuad
    const pacmanX = lerp(L.start.x, L.avatarX, moveEased);

    drawDots(t, L, pacmanX);

    if (t < T.eatAvatar) {
      drawAvatarAt(L.avatarX, L.avatarY, L.size * (1 + 0.06 * Math.sin(t / 500)), 1);
    }
    drawBurst(t, L);

    const pacAlpha = t > T.absorb ? clamp01(1 - (t - T.absorb) / 400) : 1;
    if (pacAlpha > 0) {
      ctx.save();
      ctx.globalAlpha = pacAlpha;
      drawPacMan(t, L, pacmanX, t >= T.moveStart && t <= T.moveEnd);
      ctx.restore();
    }

    if (t >= T.absorb) {
      drawBlackVeil(t, target);
      drawFlyingAvatar(t, L, target);
    }

    // 吃豆音效：每吃一颗豆播一次
    let eaten = 0;
    for (const d of L.dots) if (pacmanX >= d.x - L.size * 0.2) eaten++;
    if (eaten > lastDotIdx) {
      lastDotIdx = eaten;
      playDotSound();
    }
    if (t >= T.eatAvatar && !burstPlayed) {
      burstPlayed = true;
      playBurstSound();
    }
    if (t >= T.absorb && !swirlPlayed) {
      swirlPlayed = true;
      playSwirlSound();
    }

    if (t >= 4000) root.style.opacity = String(clamp01(1 - (t - 4000) / 200));

    if (t >= T.end) {
      finish();
      return;
    }
    rafId = requestAnimationFrame(frame);
  }

  // ---- 头像预加载：加载完成前不开始动画（避免右侧显示占位白圈） ----
  let started = false;
  const startNow = () => {
    if (started) return;
    started = true;
    root.style.display = 'block';
    root.style.opacity = '1';
    t0 = performance.now();
    document.documentElement.classList.add('pac-intro-active');
    ensureAudio();
    rafId = requestAnimationFrame(frame);
    guardTimer = window.setTimeout(finish, 8000);
  };

  if (avatarImg.complete && avatarImg.naturalWidth) {
    startNow();
  } else {
    avatarImg.addEventListener('load', startNow, { once: true });
    avatarImg.addEventListener('error', startNow, { once: true }); // 加载失败也降级开播
    // 兜底：500ms 内头像仍未就绪则强制开播（防图片路径异常）
    window.setTimeout(startNow, 500);
  }

  function skip() {
    if (finished) return;
    const now = performance.now();
    if (now - t0 < T.absorb) t0 = now - T.absorb;
    if (now - t0 >= T.end - 200) finish();
  }

  skipBtn.addEventListener('click', skip, { once: true });
  onKey = (e) => {
    if (e.key === 'Escape') {
      window.removeEventListener('keydown', onKey);
      skip();
    }
  };
  window.addEventListener('keydown', onKey);
})();
</script>
