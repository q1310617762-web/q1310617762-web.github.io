---
// 首页开屏：街机吃豆人（motion-lab 动效 + ui 令牌重构版）
//
// 动效来源（motion-lab）：
//   blur-in         舞台与背景从模糊到清晰
//   svg-dash-animate 霓虹轨道蚂蚁线
//   stagger-fade    豆子错落浮现
//   mask-reveal     标题遮罩揭示
//   typewriter      状态行逐字输入
//   pulse           能量豆呼吸
//   scale-in        吃豆人入场
//   scale-out       吃豆人与终点头像的吞入收束
//
// 规范来源（ui）：设计令牌化（无魔法值）、只动画 transform/opacity/box-shadow、
// 真实 button + 可见焦点 + ESC 可跳过、尊重 prefers-reduced-motion、<420px 不破版。
//
// 相对上一版（Canvas）的取舍：改为纯 CSS/DOM，去掉逐帧重绘与粒子数组，
// 省下大量主线程开销；保留已确认的特性 —— 逐颗吃豆音效、头像吸入侧栏真实头像、
// 匀速不减速、?intro=1 强制播放。
import { site } from '@data/site';

const rawAvatar = site.avatar || '/avatar.jpg';
const base = import.meta.env.BASE_URL || '/';
const avatarSrc = base.replace(/\/$/, '') + (rawAvatar.startsWith('/') ? rawAvatar : `/${rawAvatar}`);

const DOT_COUNT = 7;
const POWER_INDEX = 3; // 第 4 颗为能量豆
const statusText = 'INSERT COIN TO ENTER';
---

<div class="intro" data-intro aria-label="开屏动画：吃豆人进入博客">
  <!-- 记分 HUD -->
  <div class="intro-hud" aria-hidden="true">
    <div class="intro-hud-cell">
      <span class="intro-hud-label">1UP</span>
      <span class="intro-hud-value" data-intro-score>0000</span>
    </div>
    <div class="intro-hud-cell">
      <span class="intro-hud-label">HIGH SCORE</span>
      <span class="intro-hud-value">19800</span>
    </div>
  </div>

  <!-- 舞台：霓虹轨道 + 豆子 + 吃豆人 + 终点头像 -->
  <div class="intro-field" aria-hidden="true">
    <svg class="intro-rails" viewBox="0 0 100 20" preserveAspectRatio="none">
      <line class="intro-rail" x1="0" y1="5" x2="100" y2="5" />
      <line class="intro-rail" x1="0" y1="15" x2="100" y2="15" />
    </svg>

    <div class="intro-track" data-intro-track>
      <ol class="intro-dots" data-intro-dots>
        {Array.from({ length: DOT_COUNT }).map((_, i) => (
          <li class={`intro-dot${i === POWER_INDEX ? ' is-power' : ''}`} data-intro-dot style={`--i:${i}`}>
            <span class="intro-dot-core" />
          </li>
        ))}
      </ol>

      <div class="intro-pac" data-intro-pac>
        <i class="intro-pac-eye" />
      </div>

      <div class="intro-target" data-intro-target>
        <img class="intro-target-img" src={avatarSrc} alt="" />
        <span class="intro-burst" />
      </div>
    </div>
  </div>

  <!-- 字幕区：mask-reveal 标题 + typewriter 状态行 -->
  <div class="intro-caption">
    <p class="intro-title"><span class="intro-title-inner">READY!</span></p>
    <p class="intro-status">
      <span data-intro-type data-text={statusText}></span><i class="intro-caret" />
    </p>
  </div>

  <!-- 吃到头像后的飞行副本：飞向侧栏真实头像 -->
  <img class="intro-flyer" data-intro-flyer src={avatarSrc} alt="" aria-hidden="true" />

  <!-- 吸入黑幕：向侧栏头像收束 -->
  <div class="intro-veil" data-intro-veil aria-hidden="true"></div>

  <button type="button" class="intro-skip" data-intro-skip aria-label="跳过开屏动画">
    跳过 <kbd class="intro-kbd">ESC</kbd>
  </button>
</div>

<script is:inline define:vars={{ avatarSrc }}>
  window.__AVATAR_SRC__ = avatarSrc;
</script>

<script>
  (function () {
    const root = document.querySelector('[data-intro]');
    if (!(root instanceof HTMLElement) || root.dataset.bound === '1') return;
    root.dataset.bound = '1';

    // ===== 时间轴（ms）：匀速不减速，豆子按实测几何精确对齐 =====
    const S = {
      start: 700, // 吃豆人开始前进
      travel: 2400, // 匀速前进时长
      flightStart: 3160, // 头像副本起飞
      flightDur: 620,
      absorbStart: 3320, // 黑幕吸入
      absorbDur: 720,
      end: 4180, // 整幕结束
    };
    const TRAVEL_DUR_CSS = S.travel + 'ms';

    // ---- 播放频率 ----
    const PLAY_EVERY_LOAD = true; // 上线后可改 false：同一天只播一次
    const DAY_KEY = 'intro-last-day';
    const today = new Date().toDateString();
    const force = new URLSearchParams(location.search).get('intro') === '1';
    if (!force && !PLAY_EVERY_LOAD && localStorage.getItem(DAY_KEY) === today) {
      root.remove();
      return;
    }
    if (!PLAY_EVERY_LOAD) {
      try {
        localStorage.setItem(DAY_KEY, today);
      } catch {}
    }

    const pac = root.querySelector('[data-intro-pac]');
    const track = root.querySelector('[data-intro-track]');
    const target = root.querySelector('[data-intro-target]');
    const dots = Array.from(root.querySelectorAll('[data-intro-dot]'));
    const scoreEl = root.querySelector('[data-intro-score]');
    const statusEl = root.querySelector('[data-intro-type]');
    const flyer = root.querySelector('[data-intro-flyer]');
    const skipBtn = root.querySelector('[data-intro-skip]');

    const timers = [];
    const rafs = [];
    const later = (fn, ms) => timers.push(window.setTimeout(fn, ms));
    const clamp01 = (p) => (p < 0 ? 0 : p > 1 ? 1 : p);

    let finished = false;
    let scoreTimer = null;

    function finish() {
      if (finished) return;
      finished = true;
      timers.forEach((t) => window.clearTimeout(t));
      rafs.forEach((r) => cancelAnimationFrame(r));
      if (scoreTimer) window.clearInterval(scoreTimer);
      window.removeEventListener('keydown', onKey);
      window.removeEventListener('resize', relayout);
      root.classList.add('is-leaving');
      document.documentElement.classList.remove('intro-active');
      window.setTimeout(() => root.remove(), 520);
    }

    // ---- 音效：Web Audio 合成，无资源文件 ----
    let audioCtx = null;
    function ensureAudio() {
      if (!audioCtx) {
        try {
          audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        } catch {
          audioCtx = null;
        }
      }
      if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume().catch(() => {});
    }
    window.addEventListener('pointerdown', ensureAudio, { once: true });
    window.addEventListener('keydown', ensureAudio, { once: true });

    function blip(freqFrom, freqTo, dur, vol, type) {
      if (!audioCtx || audioCtx.state !== 'running') return;
      const t0 = audioCtx.currentTime;
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = type || 'sine';
      osc.frequency.setValueAtTime(freqFrom, t0);
      osc.frequency.exponentialRampToValueAtTime(freqTo, t0 + dur);
      gain.gain.setValueAtTime(vol, t0);
      gain.gain.exponentialRampToValueAtTime(0.001, t0 + dur);
      osc.connect(gain).connect(audioCtx.destination);
      osc.start(t0);
      osc.stop(t0 + dur + 0.02);
    }

    // 水漩涡吸入：白噪声低通 + 低频嗡鸣
    function swirlSound() {
      if (!audioCtx || audioCtx.state !== 'running') return;
      const t0 = audioCtx.currentTime;
      const dur = 0.9;
      const len = Math.floor(audioCtx.sampleRate * dur);
      const buf = audioCtx.createBuffer(1, len, audioCtx.sampleRate);
      const data = buf.getChannelData(0);
      for (let i = 0; i < len; i++) data[i] = Math.random() * 2 - 1;
      const noise = audioCtx.createBufferSource();
      noise.buffer = buf;
      const lp = audioCtx.createBiquadFilter();
      lp.type = 'lowpass';
      lp.frequency.setValueAtTime(800, t0);
      lp.frequency.exponentialRampToValueAtTime(120, t0 + dur);
      lp.Q.value = 4;
      const ng = audioCtx.createGain();
      ng.gain.setValueAtTime(0, t0);
      ng.gain.linearRampToValueAtTime(0.16, t0 + 0.15);
      ng.gain.exponentialRampToValueAtTime(0.001, t0 + dur);
      noise.connect(lp).connect(ng).connect(audioCtx.destination);
      noise.start(t0);
      noise.stop(t0 + dur);
      const osc = audioCtx.createOscillator();
      const og = audioCtx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(110, t0);
      osc.frequency.exponentialRampToValueAtTime(45, t0 + dur);
      og.gain.setValueAtTime(0, t0);
      og.gain.linearRampToValueAtTime(0.07, t0 + 0.2);
      og.gain.exponentialRampToValueAtTime(0.001, t0 + dur);
      osc.connect(og).connect(audioCtx.destination);
      osc.start(t0);
      osc.stop(t0 + dur);
    }

    // ---- 几何测量：把「吃豆人中心到达豆子」换算成精确延迟 ----
    function measure() {
      if (!pac || !track || !target) return null;
      const tr = track.getBoundingClientRect();
      const pr = pac.getBoundingClientRect();
      const gr = target.getBoundingClientRect();
      // 让吃豆人的「中心」正好落到终点头像的「中心」—— 既是"吃到"的画面，
      // 也保证它一定能越过最后一颗豆子（否则末颗豆子永远吃不到）。
      const travel = Math.max(0, tr.width - (pr.width + gr.width) / 2);
      root.style.setProperty('--pac-travel', travel + 'px');
      root.style.setProperty('--pac-dur', TRAVEL_DUR_CSS);

      const startCenter = pr.width / 2;
      const schedule = [];
      dots.forEach((dot) => {
        const dr = dot.getBoundingClientRect();
        const center = dr.left + dr.width / 2 - tr.left;
        const p = travel > 0 ? clamp01((center - startCenter) / travel) : 0;
        const at = S.start + S.travel * p;
        dot.style.setProperty('--eat-delay', Math.round(at) + 'ms');
        schedule.push({ at, power: dot.classList.contains('is-power') });
      });
      return schedule;
    }

    function relayout() {
      measure();
    }

    function syncVeilAndFlyer() {
      // 终点：侧栏真实头像中心（移动端侧栏在顶部，实测即可）
      const side = document.querySelector('.app-aside img');
      const fr = side ? side.getBoundingClientRect() : null;
      const trg = target ? target.getBoundingClientRect() : null;
      const to = fr && fr.width > 0
        ? { x: fr.left + fr.width / 2, y: fr.top + fr.height / 2, w: fr.width }
        : { x: window.innerWidth / 2, y: 56, w: 72 };
      root.style.setProperty('--veil-x', to.x + 'px');
      root.style.setProperty('--veil-y', to.y + 'px');

      if (flyer && trg) {
        const from = { x: trg.left + trg.width / 2, y: trg.top + trg.height / 2, w: trg.width };
        flyer.style.left = from.x + 'px';
        flyer.style.top = from.y + 'px';
        root.style.setProperty('--fly-dx', to.x - from.x + 'px');
        root.style.setProperty('--fly-dy', to.y - from.y + 'px');
        root.style.setProperty('--fly-scale', String(Math.max(0.3, to.w / Math.max(from.w, 1))));
      }
    }

    document.documentElement.classList.add('intro-active');

    // 跳过入口必须在「减少动画」提前 return 之前就注册好：
    // finish() 里要 removeEventListener(onKey)，若 onKey 还在暂时性死区，
    // finish() 会抛 ReferenceError 并且再也无法卸载开屏。
    const onKey = (e) => {
      if (e.key === 'Escape') finish();
    };
    window.addEventListener('keydown', onKey);
    skipBtn?.addEventListener('click', finish, { once: true });

    // ---- 尊重减少动画：不做位移动效，静态展示一小段后进入 ----
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) {
      root.classList.add('is-reduced');
      if (statusEl) statusEl.textContent = statusEl.getAttribute('data-text') || '';
      // 静态模式下也要把黑幕定位到侧栏头像，否则收尾时看不到目标点
      syncVeilAndFlyer();
      later(finish, 1300);
      return;
    }

    const schedule = measure();
    syncVeilAndFlyer();
    window.addEventListener('resize', relayout);
    // 量好几何、写好 --pac-travel / --eat-delay 之后再放行动效，
    // 否则豆子会因为 --eat-delay 默认 0ms 在首帧就被吃掉
    root.classList.add('is-armed');

    // ---- 记分：随吃豆进度累加 ----
    let score = 0;
    if (scoreEl) {
      scoreTimer = window.setInterval(() => {
        if (score >= 1600) return;
        score += 100;
        scoreEl.textContent = String(score).padStart(4, '0');
      }, 190);
    }

    // ---- 逐颗吃豆：到点消失 + 音效（时间与几何严格对齐）----
    if (schedule) {
      schedule.forEach((item) => {
        later(() => {
          blip(item.power ? 900 : 600, item.power ? 300 : 200, item.power ? 0.14 : 0.08, 0.11, 'sine');
        }, item.at);
      });
    }

    // ---- 3.16s 吃到头像 ----
    later(() => {
      root.classList.add('is-eaten');
      blip(400, 80, 0.3, 0.14, 'square');
    }, S.flightStart);

    // ---- 头像副本起飞 + 黑幕吸入 ----
    later(() => {
      syncVeilAndFlyer();
      root.classList.add('is-flying');
      swirlSound();
    }, S.flightStart + 10);

    later(() => root.classList.add('is-absorbing'), S.absorbStart);
    later(finish, S.end);
  })();
</script>
