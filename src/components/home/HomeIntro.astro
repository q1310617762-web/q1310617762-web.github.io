---
// 首页开屏：经典街机吃豆人吃豆子，最后一口吃下博客头像，总长4秒，自适应PC和手机。
import { site } from '@data/site';
---

<div class="pac-intro" data-home-intro aria-label="开屏动画：吃豆人进入博客">
  <!-- 顶部街机记分面板 -->
  <div class="pac-header" aria-hidden="true">
    <div class="pac-score-box">
      <span class="pac-label">1UP</span>
      <span class="pac-score" data-pac-score>0000</span>
    </div>
    <div class="pac-score-box">
      <span class="pac-label">HIGH SCORE</span>
      <span class="pac-score">19800</span>
    </div>
    <button type="button" class="pac-skip-btn" data-home-intro-skip>
      SKIP <span>ESC</span>
    </button>
  </div>

  <!-- 中间主舞台：吃豆轨道 -->
  <div class="pac-stage" aria-hidden="true">
    <!-- 霓虹街机迷宫轨道边框 -->
    <div class="pac-track-border pac-track-top"></div>
    <div class="pac-track-border pac-track-bottom"></div>

    <div class="pac-track">
      <!-- 吃豆人实体 -->
      <div class="pac-hero">
        <div class="pac-mouth-top"></div>
        <div class="pac-mouth-bottom"></div>
        <div class="pac-eye"></div>
      </div>

      <!-- 7颗发光能量豆 -->
      <div class="pac-dots">
        <span class="pac-dot dot-1"></span>
        <span class="pac-dot dot-2"></span>
        <span class="pac-dot dot-3"></span>
        <span class="pac-dot dot-4"></span>
        <span class="pac-dot dot-5"></span>
        <span class="pac-dot dot-6"></span>
        <span class="pac-dot dot-7"></span>
      </div>

      <!-- 终点：博客头像（大能量果实） -->
      <div class="pac-target">
        <div class="pac-avatar-glow"></div>
        <img
          src={site.avatar}
          alt={site.title}
          class="pac-avatar-img"
          loading="eager"
          decoding="sync"
        />
        <div class="pac-target-ring"></div>
        <!-- 吃到瞬间的爆裂光效 -->
        <div class="pac-burst"></div>
      </div>
    </div>
  </div>

  <!-- 底部像素文字与进度 -->
  <div class="pac-footer" aria-hidden="true">
    <div class="pac-title-bar">
      <span class="pac-status-text">INSERT COIN TO ENTER DYG'S BLOG...</span>
    </div>
    <div class="pac-ready-text">READY!</div>
  </div>
</div>

<script>
  function initPacIntro() {
    const intro = document.querySelector('[data-home-intro]');
    if (!(intro instanceof HTMLElement) || intro.dataset.bound === '1') return;
    intro.dataset.bound = '1';

    const scoreEl = intro.querySelector('[data-pac-score]');
    let score = 0;

    // 随着吃豆进程增加街机分数 (0 -> 100 -> 200 ... -> 1600)
    const scoreTimer = window.setInterval(() => {
      if (score < 1600) {
        score += 200;
        if (scoreEl) scoreEl.textContent = String(score).padStart(4, '0');
      }
    }, 380);

    const finish = () => {
      if (intro.dataset.finished === '1') return;
      intro.dataset.finished = '1';
      window.clearInterval(scoreTimer);
      intro.classList.add('is-leaving');
      document.documentElement.classList.remove('home-intro-active');
      window.setTimeout(() => intro.remove(), 450);
    };

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.documentElement.classList.add('home-intro-active');
    if (reduced) {
      finish();
      return;
    }

    const skip = intro.querySelector('[data-home-intro-skip]');
    skip?.addEventListener('click', finish, { once: true });

    // 支持 ESC 快速跳过
    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        window.removeEventListener('keydown', onKey);
        finish();
      }
    };
    window.addEventListener('keydown', onKey);

    // 总长 4 秒整（3.5s 吃下头像爆发，4.0s 整幕平滑退出）
    window.setTimeout(finish, 4000);
  }

  initPacIntro();
  document.addEventListener('astro:page-load', initPacIntro);
</script>
