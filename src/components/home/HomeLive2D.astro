---
// 主页 Live2D 助手 —— 默认不加载，点「召唤角色」才载入（省流量/提速）
// 两个 Cubism4 模型：布洛妮娅（先）/ 夜兰（切换时载入）。贴图 1024 WebP。
// 运行时 oh-my-live2d（内置 Cubism Core）。
const prefix = import.meta.env.BASE_URL.replace(/\/$/, '');
const MODELS = [
  { name: 'bronya', label: '布洛妮娅', path: `${prefix}/live2d/bronya/bronya.model3.json` },
  { name: 'yelan', label: '夜兰', path: `${prefix}/live2d/yelan/yelan.model3.json` },
];
const modelsJson = JSON.stringify(MODELS);
---

<div class="l2d-host" data-live2d data-models={modelsJson} aria-hidden="true"></div>

<!-- 召唤按钮：默认显示；鼠标移上去就开始预热，点击才真正加载 -->
<button class="l2d-summon" type="button" data-l2d-summon aria-label="召唤 Live2D 角色">
  <span class="l2d-summon-dot"></span>
  <span data-l2d-summon-text>召唤角色</span>
</button>

<div class="l2d-dock" data-l2d-dock aria-hidden="true">
  <button class="l2d-btn" type="button" data-l2d-switch title="切换角色" aria-label="切换角色">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5">
      <path d="M4 8h13l-3-3M20 16H7l3 3" />
    </svg>
    <span data-l2d-name>角色</span>
  </button>
  <button class="l2d-btn l2d-btn-icon" type="button" data-l2d-close title="隐藏角色" aria-label="隐藏角色">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" class="h-3.5 w-3.5">
      <path d="M6 6l12 12M18 6L6 18" />
    </svg>
  </button>
</div>

<style>
  /* oh-my-live2d 自带菜单/提示/状态条全部隐藏，只留模型本体 */
  :global(#oml2d-menus),
  :global(#oml2d-tips),
  :global(#oml2d-statusBar) {
    display: none !important;
  }
  /* 舞台与 canvas 都不吃事件；舞台降 z-index、抬高到控制按钮之上 */
  :global(#oml2d-stage) {
    z-index: 40 !important;
    pointer-events: none !important;
    bottom: 52px !important;
  }
  :global(#oml2d-canvas) {
    pointer-events: none !important;
  }

  .l2d-host {
    display: none;
  }

  /* 共用的小胶囊外观：召唤按钮 / 切换 / 隐藏 */
  .l2d-summon,
  .l2d-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 34px;
    padding: 0 13px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-surface) 86%, transparent);
    color: var(--color-muted);
    font-size: 12px;
    letter-spacing: 0.04em;
    cursor: pointer;
    backdrop-filter: blur(6px);
    transition: color 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .l2d-summon {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 100;
  }
  .l2d-summon:hover,
  .l2d-btn:hover {
    color: var(--color-primary-strong);
    border-color: var(--color-primary);
    box-shadow: 0 0 14px color-mix(in srgb, var(--color-primary) 30%, transparent);
  }
  .l2d-summon:focus-visible,
  .l2d-btn:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--color-primary) 55%, transparent);
    outline-offset: 2px;
  }
  .l2d-summon:disabled {
    cursor: progress;
    color: var(--color-muted);
  }
  .l2d-summon-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-primary);
    opacity: 0.55;
  }
  .l2d-summon:not(:disabled) .l2d-summon-dot {
    animation: l2d-blink 1.6s ease-in-out infinite alternate;
  }
  .l2d-summon:disabled .l2d-summon-dot {
    animation: l2d-pulse 0.9s ease-in-out infinite alternate;
  }
  @keyframes l2d-blink {
    from { opacity: 0.3; }
    to { opacity: 1; }
  }
  @keyframes l2d-pulse {
    from { transform: scale(0.7); opacity: 0.4; }
    to { transform: scale(1.15); opacity: 1; }
  }

  .l2d-dock {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 100;
    display: none;
    align-items: center;
    gap: 8px;
  }
  .l2d-dock.is-on {
    display: flex;
  }
  .l2d-btn-icon {
    padding: 0 10px;
  }
  @media (max-width: 420px) {
    .l2d-summon,
    .l2d-dock {
      right: 12px;
      bottom: 12px;
    }
  }
</style>

<script>
  async function boot() {
    const host = document.querySelector<HTMLElement>('[data-live2d]');
    const summon = document.querySelector<HTMLButtonElement>('[data-l2d-summon]');
    const summonText = document.querySelector<HTMLElement>('[data-l2d-summon-text]');
    const dock = document.querySelector<HTMLElement>('[data-l2d-dock]');
    const switchBtn = document.querySelector<HTMLElement>('[data-l2d-switch]');
    const nameEl = document.querySelector<HTMLElement>('[data-l2d-name]');
    const closeBtn = document.querySelector<HTMLElement>('[data-l2d-close]');
    if (!host || !summon || host.dataset.l2dInit === '1') return;
    host.dataset.l2dInit = '1';

    let models: Array<{ name: string; label: string; path: string }> = [];
    try {
      models = JSON.parse(host.dataset.models || '[]');
    } catch {}
    if (!models.length) return;

    // 热身：把运行时 chunk 与首个模型资源提前拉进缓存（鼠标悬停/点击时触发）
    let libPromise: Promise<any> | null = null;
    let prefetched = false;
    const warmup = () => {
      if (!libPromise) libPromise = import('oh-my-live2d');
      if (prefetched) return;
      prefetched = true;
      (async () => {
        try {
          const res = await fetch(models[0].path, { cache: 'force-cache' });
          if (!res.ok) return;
          const j = await res.json();
          const base = models[0].path.slice(0, models[0].path.lastIndexOf('/') + 1);
          const fr = j.FileReferences || {};
          [fr.Moc, ...(fr.Textures || []), fr.Physics, fr.DisplayInfo]
            .filter(Boolean)
            .forEach((f: string) => fetch(base + f, { cache: 'force-cache' }).catch(() => {}));
        } catch {}
      })();
    };

    let oml: any = null;
    let idx = 0;
    let loaded = false;

    const syncName = () => {
      if (nameEl) nameEl.textContent = models[idx % models.length].label;
    };

    const reveal = () => {
      const st = document.getElementById('oml2d-stage');
      if (st) st.style.display = '';
      dock?.classList.add('is-on');
      if (summon) summon.style.display = 'none';
    };
    const conceal = () => {
      const st = document.getElementById('oml2d-stage');
      if (st) st.style.display = 'none';
      dock?.classList.remove('is-on');
      if (summon) summon.style.display = '';
    };

    function mount(loadOml2d: (o: any) => any) {
      const small = window.matchMedia('(max-width: 1023px)').matches;
      // 两个模型 Cubism 画布基准高都是 6000；舞台尺寸 = 画布 × scale
      const BASE_H = 6000;
      const wantH = () =>
        small ? Math.min(window.innerHeight * 0.42, 360) : Math.min(window.innerHeight * 0.58, 520);
      const fitScale = () => wantH() / BASE_H;

      oml = loadOml2d({
        dockedPosition: 'right',
        mobileDisplay: true,
        sayHello: false,
        transitionTime: 400,
        primaryColor: '#7aa2ff',
        models: models.map((m) => ({
          name: m.name,
          path: m.path,
          scale: fitScale(),
          mobileScale: fitScale(),
          motionPreloadStrategy: 'IDLE',
        })),
        menus: { items: [] },
        tips: { style: { display: 'none' } },
        statusBar: { style: { display: 'none' } },
      });

      oml.onLoad((status: string) => {
        if (status === 'success') {
          loaded = true;
          if (summon) {
            summon.disabled = false;
            if (summonText) summonText.textContent = '召唤角色';
          }
          reveal();
          syncName();
        } else if (status === 'fail') {
          if (summon) {
            summon.disabled = false;
            if (summonText) summonText.textContent = '召唤失败，重试';
          }
        }
      });

      switchBtn?.addEventListener('click', async () => {
        idx = (idx + 1) % models.length;
        try {
          await oml.loadModelByIndex(idx);
        } catch {
          /* 切换失败保持当前模型 */
        }
        syncName();
      });

      closeBtn?.addEventListener('click', () => conceal());

      window.addEventListener('resize', () => oml.reloadModel().catch(() => {}));
    }

    // 悬停预热（不加载）
    summon.addEventListener('pointerenter', warmup);
    summon.addEventListener('focus', warmup);

    // 点击才真正加载
    summon.addEventListener('click', async () => {
      if (loaded) {
        reveal();
        return;
      }
      summon.disabled = true;
      if (summonText) summonText.textContent = '加载中…';
      warmup();
      try {
        const mod: any = await (libPromise as Promise<any>);
        if (!oml) mount(mod.loadOml2d);
      } catch (err) {
        console.error('[live2d] 加载失败', err);
        summon.disabled = false;
        if (summonText) summonText.textContent = '召唤失败，重试';
      }
    });
  }

  document.addEventListener('astro:page-load', boot);
  boot();
</script>
