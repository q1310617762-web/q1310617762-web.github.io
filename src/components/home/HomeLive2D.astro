---
// 主页 Live2D 角色 —— 取代原来的「新番更新」卡片，站在 hero 右列的位置
// 模型来源：单张立绘 → See-Through 拆 18 图层 → psd2live 自动绑骨
// 体积：整包约 327 KB（贴图已转 WebP，省 91%）
const prefix = import.meta.env.BASE_URL.replace(/\/$/, '');
const modelPath = `${prefix}/live2d/anastasya/seethrough_output.model3.json`;
---

<!-- 占位槽：保持 hero 的两栏结构不变，角色以固定定位覆盖在这一列上 -->
<div class="l2d-slot" data-l2d-slot aria-hidden="true">
  <span class="l2d-slot-hint">✦ 角色加载中…</span>
</div>

<div
  class="l2d-host"
  data-live2d
  data-model={modelPath}
  data-roam-desktop="true"
  aria-hidden="true"
></div>

<button class="l2d-close" type="button" data-l2d-close title="隐藏角色" aria-label="隐藏角色">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" class="h-3.5 w-3.5">
    <path d="M6 6l12 12M18 6L6 18" />
  </svg>
</button>

<style>
  .l2d-slot {
    min-height: 330px;
    border-radius: 16px;
    border: 1px dashed var(--color-border);
    display: grid;
    place-items: center;
  }
  .l2d-slot.is-filled {
    border-color: transparent;
  }
  .l2d-slot-hint {
    font-size: 11.5px;
    color: var(--color-muted);
    letter-spacing: 0.04em;
  }
  .l2d-slot.is-filled .l2d-slot-hint {
    display: none;
  }

  /* oh-my-live2d 会把 #oml2d-stage 直接挂到 body 上，这里用全局选择器接管它的定位与层级。
     垂直位置改用固定定位的 left/bottom 决定（由脚本按 hero 右列的位置算），
     所以把它的 transform 留给巡逻位移使用。 */
  :global(#oml2d-stage) {
    z-index: 40 !important;
    left: 0 !important;
    right: auto !important;
    bottom: 0 !important;
    pointer-events: none !important;
    will-change: transform;
  }
  :global(#oml2d-canvas) {
    pointer-events: auto !important;
  }
  :global(#oml2d-menus),
  :global(#oml2d-tips),
  :global(#oml2d-statusBar) {
    display: none !important;
  }

  .l2d-host {
    display: none;
  }

  .l2d-close {
    position: fixed;
    right: 14px;
    bottom: 14px;
    z-index: 41;
    display: none;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-muted);
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.25s ease, color 0.2s ease;
  }
  .l2d-close.is-on {
    display: grid;
  }
  .l2d-close:hover {
    opacity: 1 !important;
    color: var(--color-primary-strong);
  }
</style>

<script>
  const OFF_KEY = 'live2d-character-off';

  async function boot() {
    const host = document.querySelector<HTMLElement>('[data-live2d]');
    const slot = document.querySelector<HTMLElement>('[data-l2d-slot]');
    const closeBtn = document.querySelector<HTMLElement>('[data-l2d-close]');
    if (!host || host.dataset.l2dInit === '1') return;
    host.dataset.l2dInit = '1';

    try {
      if (localStorage.getItem(OFF_KEY) === '1') {
        slot?.classList.add('is-filled');
        return;
      }
    } catch {}

    closeBtn?.addEventListener('click', () => {
      try { localStorage.setItem(OFF_KEY, '1'); } catch {}
      closeBtn.classList.remove('is-on');
      const st = document.getElementById('oml2d-stage');
      if (st) st.style.display = 'none';
      slot?.classList.remove('is-filled');
    });

    // 等开屏动画结束，避免抢注意力
    for (let i = 0; i < 60; i++) {
      if (!document.querySelector('[data-intro]')) break;
      await new Promise((r) => setTimeout(r, 200));
    }
    if (!document.body.contains(host)) return;

    try {
      // oh-my-live2d 是【具名导出】loadOml2d，没有 default 导出。
      const { loadOml2d } = await import('oh-my-live2d');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const small = window.matchMedia('(max-width: 1023px)').matches;
      const roam = !reduced && !small;

      const fitScale = () => (small ? 0.2 : Math.max(0.16, Math.min(0.3, window.innerHeight / 3000)));

      loadOml2d({
        models: [{ path: host.dataset.model, scale: fitScale(), position: [0, 0] }],
        menus: { items: [] },
        tips: { style: { display: 'none' } },
        statusBar: { style: { display: 'none' } },
        mobileDisplay: true,
        transitionTime: 0,
      });

      closeBtn?.classList.add('is-on');
      slot?.classList.add('is-filled');

      // —— 定位到 hero 右列 ——
      // oh-my-live2d 自己用 transform: translateY(...) 做垂直偏移；我们改用固定定位的
      // left/bottom 决定落点，把 transform 的 Y 归零，只留给巡逻的 X 使用。
      let stage: HTMLElement | null = null;
      let drift = 0;
      let dir = 1;
      let frame = 0;
      let last = performance.now();

      const measure = () => {
        if (!stage || !slot) return;
        const r = slot.getBoundingClientRect();
        const w = stage.offsetWidth || 320;
        stage.style.setProperty('left', Math.max(0, Math.round(r.left + (r.width - w) / 2)) + 'px', 'important');
        stage.style.setProperty('bottom', Math.max(0, Math.round(window.innerHeight - r.bottom)) + 'px', 'important');
        if (closeBtn) {
          closeBtn.style.left = Math.round(r.left + r.width - 24) + 'px';
          closeBtn.style.top = Math.round(r.top + 4) + 'px';
          closeBtn.style.right = 'auto';
          closeBtn.style.bottom = 'auto';
        }
      };

      const speed = 16;              // px/s，非常慢
      const range = small ? 0 : 54;  // 巡逻半径，只在卡片附近小幅移动

      const tick = (now: number) => {
        const dt = Math.min((now - last) / 1000, 0.05);
        last = now;
        if (!stage) {
          stage = document.getElementById('oml2d-stage');
          if (stage) measure();
        }
        // 周期性重新定位：oh-my-live2d 会在模型加载完成、窗口变化等时机重写自己的
        // 定位样式，只在首次 measure 一次会被它覆盖（线上加载慢时就会踩到）。
        if (stage && frame % 15 === 0) measure();
        frame++;
        if (stage) {
          if (roam && range > 0) {
            drift += dir * speed * dt;
            if (drift > range) { drift = range; dir = -1; }
            if (drift < -range) { drift = -range; dir = 1; }
          }
          stage.style.transform = `translate3d(${Math.round(drift)}px, 0, 0)`;
        }
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);

      window.addEventListener('resize', () => {
        measure();
        const m = (window as any).OML2D?.models?.[0];
        if (m?.scale?.set) m.scale.set(fitScale());
      });
      // 字体加载完布局会微调，重新量一次
      setTimeout(measure, 1200);
    } catch (err) {
      console.error('[live2d] 加载失败', err);
      host.remove();
      closeBtn?.remove();
      slot?.classList.remove('is-filled');
    }
  }

  document.addEventListener('astro:page-load', boot);
  boot();
</script>


