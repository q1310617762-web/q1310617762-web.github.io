---
// 主页 Live2D 悬浮助手（右下角常驻）
// 两个 Cubism4 模型：布洛妮娅（bronya，先加载，1.6MB）/ 夜兰（yelan，切换时加载，6.2MB）
// 贴图已 4096 PNG → 2048 WebP（约 -92%）。运行时 oh-my-live2d（内置 Cubism Core）。
const prefix = import.meta.env.BASE_URL.replace(/\/$/, '');
const MODELS = [
  { name: 'bronya', label: '布洛妮娅', path: `${prefix}/live2d/bronya/bronya.model3.json` },
  { name: 'yelan', label: '夜兰', path: `${prefix}/live2d/yelan/yelan.model3.json` },
];
const modelsJson = JSON.stringify(MODELS);
---

<div class="l2d-host" data-live2d data-models={modelsJson} aria-hidden="true"></div>

<div class="l2d-loading" data-l2d-loading aria-hidden="true">
  <span class="l2d-loading-dot"></span>角色加载中…
</div>

<div class="l2d-dock" data-l2d-dock aria-hidden="true">
  <button class="l2d-btn" type="button" data-l2d-switch title="切换角色" aria-label="切换角色">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5">
      <path d="M4 8h13l-3-3M20 16H7l3 3" />
    </svg>
    <span data-l2d-name>角色</span>
  </button>
  <button class="l2d-btn l2d-btn-icon" type="button" data-l2d-close title="隐藏角色" aria-label="隐藏角色">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" class="h-3.5 w-3.5">
      <path d="M6 6l12 12M18 6L6 18" />
    </svg>
  </button>
</div>

<style>
  /* oh-my-live2d 自带菜单/提示/状态条全部隐藏，只留模型本体 */
  :global(#oml2d-menus),
  :global(#oml2d-tips),
  :global(#oml2d-statusBar) {
    display: none !important;
  }
  :global(#oml2d-stage) {
    z-index: 40 !important;
  }
  /* 舞台与 canvas 都不吃事件：模型作纯装饰，避免巨幅透明画布挡住页面与右下角按钮
     （模型本身没有动作/交互资源，戳它也不会有反应，无损失）。 */
  :global(#oml2d-stage) {
    z-index: 40 !important;
    pointer-events: none !important;
    /* 抬高到控制按钮之上，避免角色挡住「切换/隐藏」 */
    bottom: 52px !important;
  }
  :global(#oml2d-canvas) {
    pointer-events: none !important;
  }

  .l2d-host {
    display: none;
  }

  /* 加载中提示：右下角小胶囊 */
  .l2d-loading {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 100000;
    display: none;
    align-items: center;
    gap: 7px;
    min-height: 30px;
    padding: 0 12px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-surface) 82%, transparent);
    color: var(--color-muted);
    font-size: 11.5px;
    letter-spacing: 0.04em;
    backdrop-filter: blur(6px);
  }
  .l2d-loading.is-on {
    display: inline-flex;
  }
  .l2d-loading-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-primary);
    animation: l2d-blink 1s ease-in-out infinite alternate;
  }
  @keyframes l2d-blink {
    from { opacity: 0.25; }
    to { opacity: 1; }
  }

  /* 右下角控制簇：换角色 + 隐藏 */
  .l2d-dock {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 100000;
    display: none;
    align-items: center;
    gap: 8px;
  }
  .l2d-dock.is-on {
    display: flex;
  }
  .l2d-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 34px;
    padding: 0 12px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-surface) 86%, transparent);
    color: var(--color-muted);
    font-size: 12px;
    letter-spacing: 0.04em;
    cursor: pointer;
    backdrop-filter: blur(6px);
    transition: color 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .l2d-btn:hover {
    color: var(--color-primary-strong);
    border-color: var(--color-primary);
    box-shadow: 0 0 14px color-mix(in srgb, var(--color-primary) 30%, transparent);
  }
  .l2d-btn:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--color-primary) 55%, transparent);
    outline-offset: 2px;
  }
  .l2d-btn-icon {
    padding: 0 10px;
  }
  @media (max-width: 420px) {
    .l2d-dock {
      right: 12px;
      bottom: 12px;
    }
  }
</style>

<script>
  const OFF_KEY = 'live2d-character-off';

  async function boot() {
    const host = document.querySelector<HTMLElement>('[data-live2d]');
    const dock = document.querySelector<HTMLElement>('[data-l2d-dock]');
    const switchBtn = document.querySelector<HTMLElement>('[data-l2d-switch]');
    const nameEl = document.querySelector<HTMLElement>('[data-l2d-name]');
    const closeBtn = document.querySelector<HTMLElement>('[data-l2d-close]');
    if (!host || host.dataset.l2dInit === '1') return;
    host.dataset.l2dInit = '1';

    // 用户主动隐藏过就不再自动出现
    try {
      if (localStorage.getItem(OFF_KEY) === '1') return;
    } catch {}

    let models: Array<{ name: string; label: string; path: string }> = [];
    try {
      models = JSON.parse(host.dataset.models || '[]');
    } catch {}
    if (!models.length) return;

    // 省流/极慢网络下不加载（角色是重资源，别拖垮首页）
    try {
      const conn = (navigator as any).connection;
      if (conn && (conn.saveData || /slow-2g|2g/.test(conn.effectiveType || ''))) return;
    } catch {}

    const loading = document.querySelector<HTMLElement>('[data-l2d-loading]');
    const showLoading = () => loading?.classList.add('is-on');
    const hideLoading = () => loading?.classList.remove('is-on');

    // ---- 提前并行预热（关键提速）----
    // 以前是「等开屏结束才开始下载」，开屏那 ~5s 网络完全空着；
    // 这里把「运行时 chunk」和「首个模型资源」立刻拉起来，和开屏并行下载，
    // 等开屏结束时它们多半已经在缓存里了。
    const libPromise = import('oh-my-live2d');

    async function prefetchModel(url: string) {
      try {
        const res = await fetch(url, { cache: 'force-cache' });
        if (!res.ok) return;
        const j = await res.json();
        const base = url.slice(0, url.lastIndexOf('/') + 1);
        const fr = j.FileReferences || {};
        const files: string[] = [fr.Moc, ...(fr.Textures || []), fr.Physics, fr.DisplayInfo].filter(Boolean);
        files.forEach((f) => fetch(base + f, { cache: 'force-cache' }).catch(() => {}));
      } catch {}
    }
    prefetchModel(models[0].path);

    // 等开屏动画结束再出现，不抢注意力
    for (let i = 0; i < 80; i++) {
      if (!document.querySelector('[data-intro]')) break;
      await new Promise((r) => setTimeout(r, 200));
    }
    if (!document.body.contains(host)) return;

    // 开屏已让位：此刻还没加载完才显示「加载中」提示
    showLoading();

    try {
      // oh-my-live2d 是【具名导出】loadOml2d，无 default。
      const { loadOml2d } = await libPromise;
      const small = window.matchMedia('(max-width: 1023px)').matches;
      // 两个模型的 Cubism 画布基准高度都是 6000（4000×6000）。舞台宽高 = 画布 × scale，
      // 所以直接按「目标显示高度 / 6000」定 scale —— 比事后 setModelScale 可靠
      // （实测 setModelScale 不改舞台尺寸）。
      const BASE_H = 6000;
      const wantH = () =>
        small ? Math.min(window.innerHeight * 0.42, 360) : Math.min(window.innerHeight * 0.58, 520);
      const fitScale = () => wantH() / BASE_H;

      const oml = loadOml2d({
        dockedPosition: 'right',
        mobileDisplay: true,
        sayHello: false,
        transitionTime: 400,
        primaryColor: '#7aa2ff',
        models: models.map((m) => ({
          name: m.name,
          path: m.path,
          scale: fitScale(),
          mobileScale: fitScale(),
          motionPreloadStrategy: 'IDLE',
        })),
        menus: { items: [] },
        tips: { style: { display: 'none' } },
        statusBar: { style: { display: 'none' } },
      });

      let idx = 0;
      const syncName = () => {
        if (nameEl) nameEl.textContent = models[idx % models.length].label;
      };
      syncName();

      oml.onLoad((status) => {
        if (status === 'success') {
          hideLoading();
          dock?.classList.add('is-on');
          syncName();
        } else if (status === 'fail') {
          hideLoading();
        }
      });

      switchBtn?.addEventListener('click', async () => {
        idx = (idx + 1) % models.length;
        try {
          await oml.loadModelByIndex(idx);
        } catch {
          /* 加载失败静默：保持当前模型 */
        }
        syncName();
      });

      closeBtn?.addEventListener('click', () => {
        try {
          localStorage.setItem(OFF_KEY, '1');
        } catch {}
        dock?.classList.remove('is-on');
        const st = document.getElementById('oml2d-stage');
        if (st) st.style.display = 'none';
      });

      window.addEventListener('resize', () => {
        // 重新加载当前模型以套用新缩放（setModelScale 不改舞台尺寸，只能走重载）
        oml.reloadModel().catch(() => {});
      });
    } catch (err) {
      console.error('[live2d] 加载失败', err);
      hideLoading();
      host.remove();
      dock?.remove();
    }
  }

  document.addEventListener('astro:page-load', boot);
  boot();
</script>
