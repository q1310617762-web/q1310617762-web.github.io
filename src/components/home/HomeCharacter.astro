---
// 主页 3D 角色：游戏原版模型，程序化走路循环，沿页面底部巡逻
// 加载策略：开屏动画结束后、浏览器空闲时才加载；失败静默降级（不影响页面）
const prefix = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div
  class="char-stage"
  data-home-character
  data-base={prefix}
  aria-hidden="true"
>
  <canvas class="char-canvas" width="260" height="360" data-char-canvas></canvas>
  <button class="char-close" type="button" data-char-close title="隐藏角色" aria-label="隐藏角色">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" class="h-3.5 w-3.5">
      <path d="M6 6l12 12M18 6L6 18" />
    </svg>
  </button>
</div>

<style>
  .char-stage {
    position: fixed;
    left: 0;
    bottom: 0;
    width: 260px;
    height: 360px;
    z-index: 40;
    opacity: 0;
    transform: translate3d(-999px, -999px, 0);
    pointer-events: none;
    transition: opacity 0.5s ease;
    will-change: transform;
    contain: layout style;
  }
  .char-stage.is-on {
    opacity: 1;
  }
  .char-canvas {
    display: block;
    width: 260px;
    height: 360px;
    /* 角色本身可点（以后做互动），底部留一点避免遮挡正文 */
    pointer-events: none;
  }
  .char-close {
    position: absolute;
    top: 4px;
    right: 4px;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-muted);
    opacity: 0;
    pointer-events: none;
    cursor: pointer;
    transition: opacity 0.25s ease, color 0.2s ease;
  }
  .char-stage:hover .char-close {
    opacity: 1;
    pointer-events: auto;
  }
  .char-close:hover {
    color: var(--color-primary-strong);
  }
  @media (max-width: 768px) {
    .char-stage {
      width: 170px;
      height: 236px;
    }
    .char-canvas {
      width: 170px;
      height: 236px;
    }
  }
</style>

<script>
  const SEEN_KEY = 'home-character-off';

  async function boot() {
    const stage = document.querySelector<HTMLElement>('[data-home-character]');
    const canvas = document.querySelector<HTMLCanvasElement>('[data-char-canvas]');
    if (!stage || !canvas) return;
    if (stage.dataset.charInit === '1') return;
    stage.dataset.charInit = '1';

    // 用户主动关过就不再加载
    try {
      if (localStorage.getItem(SEEN_KEY) === '1') return;
    } catch {}

    const close = stage.querySelector<HTMLElement>('[data-char-close]');
    close?.addEventListener('click', (e) => {
      e.stopPropagation();
      try {
        localStorage.setItem(SEEN_KEY, '1');
      } catch {}
      stage.classList.remove('is-on');
      window.dispatchEvent(new CustomEvent('character:destroy'));
    });

    // 等开屏动画结束（最多 12s），避免和它抢注意力
    for (let i = 0; i < 60; i++) {
      if (!document.querySelector('[data-intro]')) break;
      await new Promise((r) => setTimeout(r, 200));
    }
    if (!document.body.contains(stage)) return;

    const base = stage.dataset.base || '';
    try {
      const { initHomeCharacter } = await import('../../scripts/home-character');
      const inst = await initHomeCharacter({ base, canvas, stage });
      window.addEventListener('character:destroy', () => inst.destroy(), { once: true });
      stage.classList.add('is-on');
    } catch (err) {
      // 静默降级：模型加载失败不影响页面任何功能
      console.warn('[home-character] 加载失败，已跳过', err);
      stage.remove();
    }
  }

  // 复用开屏那套：打包后的模块只会执行一次，客户端路由切页时必须重新初始化
  document.addEventListener('astro:page-load', boot);
  boot();
</script>
