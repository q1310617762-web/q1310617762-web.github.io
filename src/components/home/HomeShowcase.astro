---
// 首页卡片展示（替换原「新番更新」）
// 竖屏图集：每 20 秒随机切换一张；悬停 3D 倾斜；点击放大看大图。
const prefix = import.meta.env.BASE_URL.replace(/\/$/, '');
const CARDS = Array.from({ length: 9 }, (_, i) => `${prefix}/cards/card-${i + 1}.webp`);
const cardsJson = JSON.stringify(CARDS);
---

<section class="showcase soft-card" data-showcase data-cards={cardsJson}>
  <div class="showcase-head">
    <h2 class="showcase-title">
      <span class="primary-gradient showcase-bar" aria-hidden="true"></span>竖屏图集
    </h2>
    <span class="showcase-hint" data-showcase-hint>每 20 秒随机切换</span>
  </div>

  <div class="showcase-stage" data-showcase-stage>
    <button class="showcase-card" type="button" data-showcase-card aria-label="点击放大当前图片">
      <span class="showcase-inner" data-showcase-inner>
        <img class="showcase-img" data-showcase-img alt="" decoding="async" />
        <span class="showcase-sheen" aria-hidden="true"></span>
      </span>
    </button>
  </div>

  <div class="showcase-foot">
    <span class="showcase-count"><b data-showcase-index>1</b> / <span data-showcase-total>9</span></span>
    <button class="showcase-next" type="button" data-showcase-next aria-label="换一张">换一张</button>
  </div>
</section>

<div class="showcase-lb" data-showcase-lb hidden>
  <button class="showcase-lb-close" type="button" data-showcase-lb-close aria-label="关闭">✕</button>
  <img class="showcase-lb-img" data-showcase-lb-img alt="" />
</div>

<style>
  .showcase {
    padding: 16px;
  }
  .showcase-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
  }
  .showcase-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 700;
    color: var(--color-text-strong);
  }
  .showcase-bar {
    display: inline-block;
    width: 4px;
    height: 14px;
    border-radius: 999px;
  }
  .showcase-hint {
    flex: none;
    font-size: 11px;
    color: var(--color-muted);
    opacity: 0.75;
  }

  .showcase-stage {
    margin-top: 12px;
    perspective: 1000px;
  }
  .showcase-card {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-in;
  }
  .showcase-inner {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-card);
    transform-style: preserve-3d;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    box-shadow: var(--shadow-card);
    will-change: transform;
  }
  .showcase-card:hover .showcase-inner {
    box-shadow: var(--shadow-card-hover);
  }
  .showcase-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-card);
    backface-visibility: hidden;
    transition: transform 0.36s ease, opacity 0.36s ease;
  }
  .showcase-inner.is-flip .showcase-img {
    transform: rotateY(90deg);
    opacity: 0.15;
  }
  /* 3D 玻璃高光：随鼠标位置移动 */
  .showcase-sheen {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-card);
    background: radial-gradient(
      circle at var(--mx, 50%) var(--my, 50%),
      rgba(255, 255, 255, 0.35),
      rgba(255, 255, 255, 0) 55%
    );
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }
  .showcase-card:hover .showcase-sheen {
    opacity: 1;
  }

  .showcase-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 12px;
    font-size: 12px;
    color: var(--color-muted);
  }
  .showcase-count b {
    color: var(--color-text-strong);
    font-variant-numeric: tabular-nums;
  }
  .showcase-next {
    padding: 4px 12px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-muted);
    font-size: 12px;
    cursor: pointer;
    transition: color 0.18s ease, border-color 0.18s ease;
  }
  .showcase-next:hover {
    color: var(--color-primary-strong);
    border-color: var(--color-primary);
  }

  /* 点击放大：灯箱 */
  .showcase-lb {
    position: fixed;
    inset: 0;
    z-index: 400;
    display: grid;
    place-items: center;
    padding: 4vh 4vw;
    background: rgba(0, 0, 0, 0.82);
    backdrop-filter: blur(6px);
    cursor: zoom-out;
  }
  .showcase-lb[hidden] {
    display: none;
  }
  .showcase-lb-img {
    max-width: min(92vw, 780px);
    max-height: 88vh;
    border-radius: var(--radius-card);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
  }
  .showcase-lb-close {
    position: absolute;
    top: 18px;
    right: 20px;
    width: 38px;
    height: 38px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.4);
    color: #fff;
    font-size: 15px;
    cursor: pointer;
  }

  @media (prefers-reduced-motion: reduce) {
    .showcase-inner,
    .showcase-img {
      transition: none;
    }
  }
</style>

<script>
  // 具名函数 + astro:page-load：ClientRouter 换页后组件会重新插入，
  // 必须重新初始化（模块脚本同一 URL 只求值一次）。
  function initShowcase() {
    const root = document.querySelector<HTMLElement>('[data-showcase]');
    if (!root || root.dataset.bound === '1') return;
    root.dataset.bound = '1';

    let cards: string[] = [];
    try {
      cards = JSON.parse(root.dataset.cards || '[]');
    } catch {}
    if (!cards.length) return;

    const img = root.querySelector<HTMLImageElement>('[data-showcase-img]');
    const inner = root.querySelector<HTMLElement>('[data-showcase-inner]');
    const card = root.querySelector<HTMLElement>('[data-showcase-card]');
    const idxEl = root.querySelector<HTMLElement>('[data-showcase-index]');
    const totalEl = root.querySelector<HTMLElement>('[data-showcase-total]');
    const nextBtn = root.querySelector<HTMLElement>('[data-showcase-next]');
    const lb = document.querySelector<HTMLElement>('[data-showcase-lb]');
    const lbImg = document.querySelector<HTMLImageElement>('[data-showcase-lb-img]');
    const lbClose = document.querySelector<HTMLElement>('[data-showcase-lb-close]');
    if (!img || !inner) return;

    // 灯箱「传送」到 body：.home-page 有 transform（入场动画残留），
    // 会成为 position:fixed 的包含块，把灯箱定位到页面下方。挂到 body 才相对视口定位。
    if (lb && lb.parentElement !== document.body) {
      document.querySelectorAll('body > [data-showcase-lb]').forEach((n) => {
        if (n !== lb) n.remove();
      });
      document.body.appendChild(lb);
    }

    if (totalEl) totalEl.textContent = String(cards.length);

    // 预热全部图片，切换不闪
    cards.forEach((u) => {
      const pre = new Image();
      pre.src = u;
    });

    let idx = Math.floor(Math.random() * cards.length);
    img.src = cards[idx];
    if (idxEl) idxEl.textContent = String(idx + 1);

    let switching = false;
    const go = (next: number) => {
      if (switching || next === idx) return;
      switching = true;
      idx = next;
      inner.classList.add('is-flip');
      if (idxEl) idxEl.textContent = String(idx + 1);
      window.setTimeout(() => {
        img.src = cards[idx];
        inner.classList.remove('is-flip');
        switching = false;
      }, 180);
    };
    const randomNext = () => {
      if (cards.length === 1) return;
      let n = idx;
      while (n === idx) n = Math.floor(Math.random() * cards.length);
      go(n);
    };

    // 每 20 秒随机切换（换页重入时先清掉上一个计时器，避免累积）
    const w = window as any;
    if (w.__showcaseTimer) window.clearInterval(w.__showcaseTimer);
    const arm = () => {
      w.__showcaseTimer = window.setInterval(randomNext, 20000);
    };
    arm();
    nextBtn?.addEventListener('click', () => {
      randomNext();
      window.clearInterval(w.__showcaseTimer);
      arm();
    });

    // 悬停 3D 倾斜
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduced && card) {
      const MAX = 12;
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width;
        const py = (e.clientY - r.top) / r.height;
        inner.style.setProperty('--ry', `${(px - 0.5) * 2 * MAX}deg`);
        inner.style.setProperty('--rx', `${(0.5 - py) * 2 * MAX}deg`);
        inner.style.setProperty('--mx', `${px * 100}%`);
        inner.style.setProperty('--my', `${py * 100}%`);
      });
      card.addEventListener('pointerleave', () => {
        inner.style.setProperty('--rx', '0deg');
        inner.style.setProperty('--ry', '0deg');
        inner.style.setProperty('--mx', '50%');
        inner.style.setProperty('--my', '50%');
      });
    }

    // 点击放大（灯箱）
    const openLb = () => {
      if (!lb || !lbImg) return;
      lbImg.src = cards[idx];
      lb.hidden = false;
      document.documentElement.style.overflow = 'hidden';
    };
    const closeLb = () => {
      if (!lb) return;
      lb.hidden = true;
      document.documentElement.style.overflow = '';
    };
    card?.addEventListener('click', openLb);
    lb?.addEventListener('click', closeLb);
    lbClose?.addEventListener('click', closeLb);
    if (!w.__showcaseKey) {
      w.__showcaseKey = true;
      document.addEventListener('keydown', (e) => {
        const l = document.querySelector<HTMLElement>('[data-showcase-lb]');
        if (e.key === 'Escape' && l && !l.hidden) {
          l.hidden = true;
          document.documentElement.style.overflow = '';
        }
      });
    }
  }

  initShowcase();
  document.addEventListener('astro:page-load', initShowcase);
</script>
