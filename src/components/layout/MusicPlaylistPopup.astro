---
// 曲单弹出小窗
// 注意：它渲染在 BaseLayout 里、<body> 之下、.app 之外。
// 侧栏 .app-aside 有 overflow-y:auto 和 backdrop-filter，
// 放在侧栏内部会被裁剪、且 fixed 定位会以侧栏为基准，因此必须挂到外面。
import { music } from '@data/site';
const tracks = music;
---

{
  tracks.length > 0 && (
    <div
      id="music-popup"
      data-music-popup
      class="music-popup"
      role="dialog"
      aria-label="曲单"
    >
      <div class="music-popup-head">
        <span class="music-popup-title">曲单</span>
        <span class="music-popup-count">{tracks.length} 首</span>
        <button
          data-music-popup-close
          type="button"
          class="music-popup-close"
          aria-label="关闭曲单"
          title="关闭"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-3.5 w-3.5">
            <path d="M18 6 6 18M6 6l12 12" />
          </svg>
        </button>
      </div>

      <ul class="music-popup-list">
        {tracks.map((t, i) => (
          <li>
            <button
              data-track
              data-src={t.src}
              data-title={t.title}
              data-artist={t.artist}
              data-index={i}
              type="button"
              class="music-track"
            >
              <span data-track-index class="music-track-index">{i + 1}</span>
              <span class="music-track-meta">
                <span data-track-title class="music-track-title">{t.title}</span>
                <span data-track-artist class="music-track-artist">{t.artist}</span>
              </span>
              <span class="music-track-bars" aria-hidden="true">
                <i /><i /><i />
              </span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  )
}
