---
// 精选文章大卡片组件（首页置顶展示）
import { formatDate, readingTime } from '@utils/posts';
import type { Post } from '@utils/posts';
import TagList from '../ui/TagList.astro';

const { post } = Astro.props;
---

<a href={`/blog/${post.slug}`} class="group block">
  <div
    class="relative overflow-hidden rounded-(--radius-card) border border-(--color-primary)/30 bg-(--color-surface) p-7 shadow-(--shadow-card) transition-all duration-300 group-hover:-translate-y-1.5 group-hover:border-(--color-primary)/55 group-hover:shadow-(--shadow-card-hover) dark:border-(--color-primary)/30 dark:bg-(--color-dark-surface) sm:p-9"
  >
    <!-- 顶部渐变条 -->
    <div class="primary-gradient absolute inset-x-0 top-0 h-1" aria-hidden="true"></div>

    <div class="mb-4 flex flex-wrap items-center gap-2 text-xs text-(--color-muted) dark:text-(--color-dark-muted)">
      <span class="inline-flex items-center rounded-(--radius-pill) border border-(--color-accent)/40 bg-(--color-accent)/15 px-2.5 py-0.5 font-medium text-(--color-accent-2) dark:text-(--color-accent-2)">
        ⭐ 精选
      </span>
      <span class="inline-flex items-center rounded-(--radius-pill) border border-(--color-primary)/30 bg-(--color-primary)/12 px-2.5 py-0.5 font-medium text-(--color-primary-strong) dark:text-(--color-primary)">
        {post.category}
      </span>
      <time datetime={post.pubDate.toISOString()}>{formatDate(post.pubDate)}</time>
      <span>·</span>
      <span>{readingTime(post.body)}</span>
    </div>

    <h3 class="text-2xl font-extrabold leading-tight text-(--color-text) transition-colors duration-200 group-hover:text-(--color-primary) dark:text-(--color-dark-text) sm:text-3xl">
      {post.title}
    </h3>
    <p class="mt-3 max-w-2xl text-(--color-muted) dark:text-(--color-dark-muted)">{post.description}</p>

    <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
      <TagList tags={post.tags} />
      <span class="inline-flex items-center gap-1 text-sm font-semibold text-(--color-primary)">
        阅读全文
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
      </span>
    </div>
  </div>
</a>
