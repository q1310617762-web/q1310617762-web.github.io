---
// 文章卡片（参考图风格：标题 + 日期右对齐 + 描述 + 标签胶囊）
import type { Post } from '@utils/posts';

const { post } = Astro.props;
---

<a href={`/blog/${post.slug}`} class="group block h-full">
  <article class="soft-card soft-card-hover flex h-full flex-col p-5">
    <div class="flex items-start justify-between gap-3">
      <h3
        class="text-[15px] font-bold leading-snug text-(--color-text-strong) transition-colors group-hover:text-(--color-primary-strong)"
      >
        {post.title}
      </h3>
      <time datetime={post.pubDate.toISOString()} class="mt-0.5 shrink-0 text-[11px] tabular-nums text-(--color-muted)">
        {post.pubDate.toISOString().slice(0, 10)}
      </time>
    </div>

    <p class="mt-2.5 line-clamp-3 flex-1 text-[13px] leading-relaxed text-(--color-muted)">
      {post.description}
    </p>

    <div class="mt-4 flex flex-wrap gap-1.5">
      <span class="pill">{post.category}</span>
      {post.tags.slice(0, 3).map((t) => <span class="pill">#{t}</span>)}
    </div>
  </article>
</a>
