---
// 图片墙组件（多相册分组 + 共用灯箱）
// 顺序：随手拍（自动同步）→ 家人相册（加密）→ 游戏截图相册
// 灯箱用事件委托绑定在外层容器上，因此解锁后动态出现的图片也能点击查看
import { albums as albumData } from '@data/site';
import { getPhotoAlbum } from '@utils/photos';
import GatedAlbum from './GatedAlbum.astro';

const auto = getPhotoAlbum();

const Card = null; // 占位（模板里直接用内联结构，便于两类相册复用同一套样式）
---
<div data-gallery-root>
  {
    auto && (
      <section class="mb-12">
        <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
          <h2 class="text-xl font-bold text-(--color-text-strong)">{auto.name}</h2>
          <span class="text-xs text-(--color-muted) dark:text-(--color-dark-muted)">
            {auto.items.length} 张 · {auto.desc}
          </span>
        </div>
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
          {auto.items.map((it) => (
            <button
              data-gallery-item
              data-src={it.src}
              data-title={it.title}
              data-desc={it.desc}
              type="button"
              class="group relative aspect-[4/3] overflow-hidden rounded-(--radius-card) border border-(--color-border) bg-(--color-surface) shadow-(--shadow-card) transition-all duration-300 hover:-translate-y-1.5 hover:border-(--color-primary)/45 hover:shadow-(--shadow-card-hover) dark:border-(--color-dark-border) dark:bg-(--color-dark-surface)"
            >
              <img
                src={it.src}
                alt={it.title}
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <span
                class="absolute inset-x-0 bottom-0 p-3 text-left opacity-0 transition-opacity duration-300 group-hover:opacity-100"
                style="background: linear-gradient(to top, rgba(0,0,0,.72), rgba(0,0,0,0));"
              >
                <span class="block text-sm font-semibold text-white">{it.title}</span>
                <span class="block text-xs text-white/75">{it.desc}</span>
              </span>
            </button>
          ))}
        </div>
      </section>
    )
  }

  <!-- 家人相册（加密，需口令解锁） -->
  <GatedAlbum />

  {
    albumData.map((album) => (
      <section class="mb-12 last:mb-0">
        <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
          <h2 class="text-xl font-bold text-(--color-text-strong)">{album.name}</h2>
          <span class="text-xs text-(--color-muted) dark:text-(--color-dark-muted)">
            {album.items.length} 张 · {album.desc}
          </span>
        </div>
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
          {album.items.map((it) => (
            <button
              data-gallery-item
              data-src={it.src}
              data-title={it.title}
              data-desc={it.desc}
              type="button"
              class="group relative aspect-[4/3] overflow-hidden rounded-(--radius-card) border border-(--color-border) bg-(--color-surface) shadow-(--shadow-card) transition-all duration-300 hover:-translate-y-1.5 hover:border-(--color-primary)/45 hover:shadow-(--shadow-card-hover) dark:border-(--color-dark-border) dark:bg-(--color-dark-surface)"
            >
              <img
                src={it.src}
                alt={it.title}
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <span
                class="absolute inset-x-0 bottom-0 p-3 text-left opacity-0 transition-opacity duration-300 group-hover:opacity-100"
                style="background: linear-gradient(to top, rgba(0,0,0,.72), rgba(0,0,0,0));"
              >
                <span class="block text-sm font-semibold text-white">{it.title}</span>
                <span class="block text-xs text-white/75">{it.desc}</span>
              </span>
            </button>
          ))}
        </div>
      </section>
    ))
  }
</div>

<!-- 灯箱 -->
<div
  data-lightbox
  class="fixed inset-0 z-[60] hidden items-center justify-center bg-black/85 p-4 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-label="图片查看"
>
  <button data-lb-close type="button" aria-label="关闭" class="absolute right-4 top-4 flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d="M18 6 6 18M6 6l12 12" /></svg>
  </button>
  <button data-lb-prev type="button" aria-label="上一张" class="absolute left-3 flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="m15 18-6-6 6-6" /></svg>
  </button>
  <button data-lb-next type="button" aria-label="下一张" class="absolute right-3 flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="m9 18 6-6-6-6" /></svg>
  </button>
  <figure class="flex max-h-full max-w-4xl flex-col items-center">
    <img data-lb-img src="" alt="" class="max-h-[78vh] w-auto rounded-(--radius-card) shadow-2xl" />
    <figcaption class="mt-3 text-center">
      <span data-lb-title class="block text-sm font-semibold text-white"></span>
      <span data-lb-desc class="block text-xs text-white/70"></span>
    </figcaption>
  </figure>
</div>

<script>
  function initGallery() {
    const rootEl = document.querySelector('[data-gallery-root]');
    if (!rootEl) return;

    const box = document.querySelector('[data-lightbox]');
    const img = box.querySelector('[data-lb-img]');
    const title = box.querySelector('[data-lb-title]');
    const desc = box.querySelector('[data-lb-desc]');
    let cur = 0;

    // 每次实时收集，支持解锁后动态加入的图片
    const allItems = () => [...document.querySelectorAll('[data-gallery-item]')];

    const show = (i) => {
      const list = allItems();
      if (!list.length) return;
      cur = ((i % list.length) + list.length) % list.length;
      const it = list[cur];
      img.src = it.dataset.src;
      img.alt = it.dataset.title;
      title.textContent = it.dataset.title;
      desc.textContent = it.dataset.desc;
    };
    const open = (i) => {
      show(i);
      box.classList.remove('hidden');
      box.classList.add('flex');
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      box.classList.add('hidden');
      box.classList.remove('flex');
      document.body.style.overflow = '';
    };

    // 事件委托：一次绑定，动态加入的图片同样有效
    if (rootEl.dataset.lbBound !== '1') {
      rootEl.dataset.lbBound = '1';
      rootEl.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-gallery-item]');
        if (!btn) return;
        open(allItems().indexOf(btn));
      });
    }

    if (box.dataset.lbBound !== '1') {
      box.dataset.lbBound = '1';
      box.querySelector('[data-lb-close]').addEventListener('click', close);
      box.querySelector('[data-lb-prev]').addEventListener('click', () => show(cur - 1));
      box.querySelector('[data-lb-next]').addEventListener('click', () => show(cur + 1));
      box.addEventListener('click', (e) => {
        if (e.target === box) close();
      });
    }

    if (window.__lbKeys) document.removeEventListener('keydown', window.__lbKeys);
    const onKey = (e) => {
      if (box.classList.contains('hidden')) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') show(cur - 1);
      if (e.key === 'ArrowRight') show(cur + 1);
    };
    window.__lbKeys = onKey;
    document.addEventListener('keydown', onKey);
  }
  initGallery();
  document.addEventListener('astro:page-load', initGallery);
</script>
