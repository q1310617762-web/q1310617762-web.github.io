---
// 新番更新列表（数据来自 B 站番剧时间线，构建时静态生成）
import { getAnimeSchedule, getAnimeUpdatedLabel, animeData } from '@utils/anime';

const days = getAnimeSchedule(3, 6);
const hasData = days.length > 0;
const dayLabel = (d: (typeof days)[number]) => (d.isToday ? '今天' : `周${d.weekday}`);
---

{
  hasData && (
    <section class="soft-card p-5">
      <div class="flex items-baseline justify-between gap-3">
        <h2 class="flex items-center gap-2 text-[15px] font-bold text-(--color-text-strong)">
          <span class="primary-gradient inline-block h-3.5 w-1 rounded-full" aria-hidden="true" />新番更新
        </h2>
        <a
          href="https://www.bilibili.com/anime/timeline/"
          target="_blank"
          rel="noopener noreferrer"
          class="shrink-0 text-[11px] text-(--color-muted) transition-colors hover:text-(--color-primary-strong)"
        >
          本周 {animeData.total} 部 →
        </a>
      </div>

      <div class="mt-3.5 max-h-[330px] space-y-4 overflow-y-auto pr-1">
        {days.map((day) => (
          <div>
            <p class="flex items-center gap-2 text-[11px] font-medium text-(--color-muted)">
              <span
                class={
                  day.isToday
                    ? 'rounded-(--radius-pill) bg-(--color-primary) px-2 py-0.5 text-[10px] text-white'
                    : 'rounded-(--radius-pill) border border-(--color-border) px-2 py-0.5 text-[10px]'
                }
              >
                {dayLabel(day)}
              </span>
              <span class="tabular-nums">{day.date}</span>
              <span class="opacity-60">{day.episodes.length} 部</span>
            </p>
            <ul class="mt-2 space-y-1.5">
              {day.episodes.map((ep) => (
                <li>
                  <a
                    href={ep.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex items-center gap-2.5 rounded-(--radius-sm) p-1 transition-colors hover:bg-(--color-surface-2)"
                    title={`${ep.title} ${ep.index}`}
                  >
                    {ep.cover ? (
                      <img
                        src={ep.cover}
                        alt={ep.title}
                        width="34"
                        height="46"
                        loading="lazy"
                        referrerpolicy="no-referrer"
                        onerror="this.style.visibility='hidden'"
                        class="h-[46px] w-[34px] shrink-0 rounded-md object-cover shadow-sm"
                      />
                    ) : (
                      <span class="h-[46px] w-[34px] shrink-0 rounded-md bg-(--color-surface-2)" />
                    )}
                    <span class="min-w-0 flex-1">
                      <span class="block truncate text-[12.5px] font-medium text-(--color-text) transition-colors group-hover:text-(--color-primary-strong)">
                        {ep.title}
                      </span>
                      <span class="mt-0.5 block truncate text-[10.5px] text-(--color-muted)">
                        {ep.index} · {ep.time}
                        {ep.delay ? ` · ${ep.delay}` : ''}
                      </span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <p class="mt-3.5 border-t border-(--color-border) pt-2.5 text-[10px] text-(--color-muted)">
        数据来自 B 站番剧时间线 · 更新于 {getAnimeUpdatedLabel()}
      </p>
    </section>
  )
}
