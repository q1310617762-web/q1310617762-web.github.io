---
// 全站基础布局：左侧栏 + 主内容区
import '@styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SiteSidebar from '@components/layout/SiteSidebar.astro';
import Footer from '@components/layout/Footer.astro';
import BackToTop from '@components/layout/BackToTop.astro';
import MusicPlaylistPopup from '@components/layout/MusicPlaylistPopup.astro';
import { site } from '@data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  activeNav?: string;
}
const {
  title,
  description = site.description,
  image = '/og-image.svg',
  activeNav = '/',
} = Astro.props;

const pageTitle = title ? `${title} · ${site.title}` : site.title;

// 子路径前缀（GitHub Pages 项目页会用到）；BASE_URL 形如 "/" 或 "/my-blog/"
const basePath = import.meta.env.BASE_URL || '/';
// 用 Astro 解析出的真实站点地址（来自 astro.config 的 site），
// 不要用 site.ts 里的 site.url —— 那是展示用文案，仍是 example.com 占位符，
// 拿它拼 og:image 会让社交平台抓到 404。
const origin = Astro.site?.origin || new URL(Astro.url).origin;
const ogImage = new URL(basePath.replace(/\/$/, '') + image, origin).href;
---
<!doctype html>
<html lang={site.lang} data-theme="day">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={site.keywords.join(', ')} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <!-- 站点根路径（供客户端脚本拼接站内地址，兼容 GitHub Pages 子路径） -->
    <script is:inline define:vars={{ basePath }}>
      window.__BASE__ = basePath;
    </script>

    <!-- 首屏应用主题，避免闪烁 -->
    <script is:inline>
      (function () {
        try {
          var kind = localStorage.getItem('theme-kind');
          if (!kind) {
            var old = localStorage.getItem('theme');
            var preferDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            kind = old === 'dark' || (!old && preferDark) ? 'night' : 'day';
          }
          var de = document.documentElement;
          de.setAttribute('data-theme', kind);
          if (kind === 'night') de.classList.add('dark');
        } catch (e) {}
      })();
    </script>

    <slot name="head" />
    <ClientRouter />

    <!-- 开屏判定用：记录「本文档最初是从哪个路径加载的」。
         首页组件的脚本据此判断自己是「整页加载首页」还是「被站内导航带出来的」。
         必须放在布局里（每个页面都会加载）：从子页进首页时，组件脚本
         是换页那一刻才第一次加载的。
         这里刻意**不用**监听 astro:after-swap —— 它和组件脚本的执行顺序
         没有保证（组件脚本可能在 after-swap 派发之前就跑完了，实测线上会偶发失效）。
         记录初始路径则在文档加载时就写好，不存在顺序问题。 -->
    <script is:inline>
      window.__initialPath = location.pathname;
    </script>

    <!-- 切页后重新应用主题（View Transitions 会覆盖 <html> 属性） -->
    <script>
      function applyThemeClass() {
        try {
          const kind = localStorage.getItem('theme-kind') || 'day';
          const de = document.documentElement;
          de.setAttribute('data-theme', kind);
          de.classList.toggle('dark', kind === 'night');
        } catch {}
      }
      document.addEventListener('astro:after-swap', applyThemeClass);
      applyThemeClass();
    </script>
  </head>
  <body>
    <!-- 壁纸层：每页随机一张，跨页保留（transition:persist）以便交叉淡入淡出 -->
    <div class="bg-wallpaper" data-bgwall aria-hidden="true" transition:persist="bgwall">
      <span class="bg-wallpaper-layer" data-bglayer></span>
      <span class="bg-wallpaper-layer" data-bglayer></span>
    </div>
    <div class="app">
      <SiteSidebar active={activeNav} />
      <div class="app-body">
        <main class="app-content">
          <slot />
        </main>
        <Footer />
      </div>
    </div>
    <BackToTop />
    <!-- 曲单浮层：必须放在 .app 之外，否则会被侧栏的 overflow 裁剪 -->
    <MusicPlaylistPopup />
  </body>

  <script>
    // 每页随机壁纸 + 平滑交叉淡入淡出
    (function () {
      const BASE = ((window as any).__BASE__ || '/').replace(/\/$/, '');
      const WALLS = Array.from(
        { length: 5 },
        (_, i) => `${BASE}/wallpapers/wallpaper-${i + 1}.webp`,
      );
      const box = document.querySelector('[data-bgwall]');
      if (!box) return;
      const layers = Array.from(box.querySelectorAll('[data-bglayer]')) as HTMLElement[];
      if (layers.length < 2) return;

      let active = 0;
      let cur = -1;
      let last = 0;

      const randomIndex = () => {
        if (WALLS.length <= 1) return 0;
        let i = cur;
        while (i === cur) i = Math.floor(Math.random() * WALLS.length);
        return i;
      };

      const apply = (i: number) => {
        const url = WALLS[i];
        const next = layers[1 - active];
        const img = new Image();
        const commit = () => {
          next.style.backgroundImage = `url("${url}")`;
          requestAnimationFrame(() => {
            next.classList.add('is-active');
            layers[active].classList.remove('is-active');
            active = 1 - active;
            cur = i;
          });
        };
        img.onload = commit;
        img.onerror = commit;
        img.src = url;
      };

      const randomize = () => {
        const now = Date.now();
        if (now - last < 600) return; // 合并初次加载时 astro:page-load 与直接调用的双触发
        last = now;
        apply(randomIndex());
      };

      randomize();
      document.addEventListener('astro:page-load', randomize);
    })();
  </script>

  <script>
    // 为所有代码块添加复制按钮
    function initCodeCopy() {
      document.querySelectorAll('pre').forEach((pre) => {
        if (pre.closest('.code-block')) return;
        const wrapper = document.createElement('div');
        wrapper.className = 'code-block relative group';
        pre.parentNode?.insertBefore(wrapper, pre);
        wrapper.appendChild(pre);
        const btn = document.createElement('button');
        btn.className =
          'absolute right-2 top-2 rounded-md bg-white/10 px-2 py-1 text-xs text-white opacity-0 transition-opacity group-hover:opacity-100';
        btn.textContent = '复制';
        wrapper.appendChild(btn);
        btn.addEventListener('click', () => {
          const code = pre.querySelector('code')?.textContent ?? '';
          navigator.clipboard?.writeText(code).then(() => {
            btn.textContent = '已复制';
            setTimeout(() => (btn.textContent = '复制'), 1500);
          });
        });
      });
    }
    initCodeCopy();
    document.addEventListener('astro:page-load', initCodeCopy);
  </script>
</html>
